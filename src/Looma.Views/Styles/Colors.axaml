<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- global theme -->
    <Color x:Key="SystemAccentColor">#F472B6</Color>
    <Color x:Key="SystemAccentColorLight1">#F9A8D4</Color>
    <Color x:Key="SystemAccentColorLight2">#FCE7F3</Color>
    <Color x:Key="SystemAccentColorDark1">#DB2777</Color>
    <Color x:Key="SystemAccentColorDark2">#9D174D</Color>

    <!-- Couleurs principales - Rose pastel -->
    <SolidColorBrush x:Key="PrimaryBrush">#F9A8D4</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryDarkBrush">#F472B6</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryLightBrush">#FCE7F3</SolidColorBrush>

    <!-- Couleurs secondaires -->
    <SolidColorBrush x:Key="SecondaryBrush">#DDA0DD</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush">#FFB6C1</SolidColorBrush>

    <!-- Couleurs de texte -->
    <SolidColorBrush x:Key="TextPrimaryBrush">#4A4A4A</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondaryBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="TextWhiteBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="TextOnPrimaryBrush">#831843</SolidColorBrush>

    <!-- Couleurs de fond -->
    <SolidColorBrush x:Key="BackgroundBrush">#FFF5F7</SolidColorBrush>
    <SolidColorBrush x:Key="BackgroundHoverBrush">#FDF2F8</SolidColorBrush>
    <SolidColorBrush x:Key="BackgroundCardBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="TransparentBrush">Transparent</SolidColorBrush>

    <!-- Couleurs d'état -->
    <SolidColorBrush x:Key="SuccessBrush">#A7F3D0</SolidColorBrush>
    <SolidColorBrush x:Key="WarningBrush">#FED7AA</SolidColorBrush>
    <SolidColorBrush x:Key="ErrorBrush">#FECACA</SolidColorBrush>
    <SolidColorBrush x:Key="InfoBrush">#BFDBFE</SolidColorBrush>

    <!-- Bordures et séparateurs -->
    <SolidColorBrush x:Key="BorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="DividerBrush">#FCE7F3</SolidColorBrush>

    <!-- Boutons -->
    <SolidColorBrush x:Key="CancelButtonForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="CancelButtonBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="CancelButtonHoverBackgroundBrush">#FDF2F8</SolidColorBrush>
    <SolidColorBrush x:Key="CancelButtonHoverBorderBrush">#F472B6</SolidColorBrush>
    <SolidColorBrush x:Key="CancelButtonHoverForegroundBrush">#DB2777</SolidColorBrush>
    <SolidColorBrush x:Key="DangerButtonBackgroundBrush">#FEF2F2</SolidColorBrush>
    <SolidColorBrush x:Key="DangerButtonForegroundBrush">#EF4444</SolidColorBrush>
    <SolidColorBrush x:Key="DangerButtonBorderBrush">#FECACA</SolidColorBrush>
    <SolidColorBrush x:Key="DangerButtonHoverBackgroundBrush">#FEE2E2</SolidColorBrush>
    <SolidColorBrush x:Key="DangerButtonHoverForegroundBrush">#DC2626</SolidColorBrush>
    <SolidColorBrush x:Key="DangerSolidButtonBackgroundBrush">#EF4444</SolidColorBrush>
    <SolidColorBrush x:Key="DangerSolidButtonForegroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="DangerSolidButtonIconForegroundBrush">#FFF7F7</SolidColorBrush>
    <SolidColorBrush x:Key="DangerSolidButtonHoverBackgroundBrush">#DC2626</SolidColorBrush>
    <SolidColorBrush x:Key="DangerSolidButtonHoverForegroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="DangerSolidButtonHoverIconForegroundBrush">#FFECEC</SolidColorBrush>
    <SolidColorBrush x:Key="PaginationButtonForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="PaginationButtonHoverForegroundBrush">#F472B6</SolidColorBrush>
    <SolidColorBrush x:Key="SubmitButtonBackgroundBrush">#7C3AED</SolidColorBrush>
    <SolidColorBrush x:Key="SubmitButtonForegroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="SubmitButtonIconForegroundBrush">#FFF7FD</SolidColorBrush>
    <SolidColorBrush x:Key="SubmitButtonHoverBackgroundBrush">#6D28D9</SolidColorBrush>
    <SolidColorBrush x:Key="SubmitButtonHoverForegroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="SubmitButtonHoverIconForegroundBrush">#FCE7F3</SolidColorBrush>
    <SolidColorBrush x:Key="SubmitButtonDisabledBackgroundBrush">#F3E8FF</SolidColorBrush>

    <!-- Formulaires -->
    <SolidColorBrush x:Key="FormDividerBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="FormControlBackgroundBrush">#FFF5F7</SolidColorBrush>
    <SolidColorBrush x:Key="FormControlBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="FormControlForegroundBrush">#4A4A4A</SolidColorBrush>
    <SolidColorBrush x:Key="FormControlPlaceholderForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="FormControlFocusBackgroundBrush">#FFF5F7</SolidColorBrush>
    <SolidColorBrush x:Key="FormControlHoverBorderBrush">#F472B6</SolidColorBrush>
    <SolidColorBrush x:Key="FormControlFocusBorderBrush">#7C3AED</SolidColorBrush>
    <SolidColorBrush x:Key="FormOptionForegroundBrush">#4A4A4A</SolidColorBrush>
    <SolidColorBrush x:Key="FormOptionHoverForegroundBrush">#DB2777</SolidColorBrush>
    <SolidColorBrush x:Key="ColorPickerContainerBackgroundBrush">#FFF5F7</SolidColorBrush>
    <SolidColorBrush x:Key="ColorPickerContainerBorderBrush">#F3E8FF</SolidColorBrush>

    <!-- Surfaces et listes -->
    <SolidColorBrush x:Key="InteractiveCardHoverBackgroundBrush">#FDF2F8</SolidColorBrush>
    <SolidColorBrush x:Key="InteractiveCardHoverBorderBrush">#F472B6</SolidColorBrush>
    <SolidColorBrush x:Key="SelectionRowBackgroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="SelectionRowBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="SelectionRowHoverBackgroundBrush">#FDF2F8</SolidColorBrush>
    <SolidColorBrush x:Key="SelectionRowSelectedBackgroundBrush">#FDF2F8</SolidColorBrush>
    <SolidColorBrush x:Key="SelectionRowSelectedBorderBrush">#F472B6</SolidColorBrush>
    <SolidColorBrush x:Key="TableHeaderBackgroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="TableHeaderBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="TableRowBackgroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="TableRowBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="LinkedRowBackgroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="LinkedRowBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="LinkedRowHoverBackgroundBrush">#FDF2F8</SolidColorBrush>
    <SolidColorBrush x:Key="LinkedRowHoverBorderBrush">#F472B6</SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceCardBackgroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceCardBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="SurfacePanelBackgroundBrush">#FFF5F7</SolidColorBrush>
    <SolidColorBrush x:Key="SurfacePanelBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceChipBackgroundBrush">#FFF5F7</SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceChipBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="EmptyStateBackgroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="EmptyStateBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="EmptyStateTitleForegroundBrush">#F472B6</SolidColorBrush>
    <SolidColorBrush x:Key="AlertErrorBackgroundBrush">#FEF2F2</SolidColorBrush>
    <SolidColorBrush x:Key="AlertErrorBorderBrush">#FECACA</SolidColorBrush>

    <!-- Navigation -->
    <SolidColorBrush x:Key="TabForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="TabIconForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="TabHoverBackgroundBrush">#FDF2F8</SolidColorBrush>
    <SolidColorBrush x:Key="TabHoverForegroundBrush">#DB2777</SolidColorBrush>
    <SolidColorBrush x:Key="TabHoverIconForegroundBrush">#DB2777</SolidColorBrush>
    <SolidColorBrush x:Key="TabSelectedBackgroundBrush">#F9A8D4</SolidColorBrush>
    <SolidColorBrush x:Key="TabSelectedForegroundBrush">#831843</SolidColorBrush>
    <SolidColorBrush x:Key="TabSelectedIconForegroundBrush">#831843</SolidColorBrush>
    <SolidColorBrush x:Key="TabSelectedHoverBackgroundBrush">#FCE7F3</SolidColorBrush>
    <SolidColorBrush x:Key="TabSelectedHoverForegroundBrush">#831843</SolidColorBrush>
    <SolidColorBrush x:Key="TabSelectedHoverIconForegroundBrush">#831843</SolidColorBrush>

    <!-- Rubans -->
    <SolidColorBrush x:Key="StatusWishlistRibbonBackgroundBrush">#F9A8D4</SolidColorBrush>
    <SolidColorBrush x:Key="StatusInProgressRibbonBackgroundBrush">#FDBA74</SolidColorBrush>
    <SolidColorBrush x:Key="StatusFinishedRibbonBackgroundBrush">#86EFAC</SolidColorBrush>
    <SolidColorBrush x:Key="StatusPausedRibbonBackgroundBrush">#FCA5A5</SolidColorBrush>
    <SolidColorBrush x:Key="PatternCrochetRibbonBackgroundBrush">#F9A8D4</SolidColorBrush>
    <SolidColorBrush x:Key="PatternTunisianCrochetRibbonBackgroundBrush">#93C5FD</SolidColorBrush>
    <SolidColorBrush x:Key="PatternTricotRibbonBackgroundBrush">#C4A484</SolidColorBrush>
    <SolidColorBrush x:Key="WarningTextForegroundBrush">#991B1B</SolidColorBrush>

    <!-- Elements -->
    <SolidColorBrush x:Key="PageTitleForegroundBrush">#4A4A4A</SolidColorBrush>
    <SolidColorBrush x:Key="PageSubtitleForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="FormTitleForegroundBrush">#F472B6</SolidColorBrush>
    <SolidColorBrush x:Key="FormSubtitleForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="SectionTitleForegroundBrush">#F472B6</SolidColorBrush>
    <SolidColorBrush x:Key="FormLabelForegroundBrush">#4A4A4A</SolidColorBrush>
    <SolidColorBrush x:Key="FormHintForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="FieldRequiredForegroundBrush">#EF4444</SolidColorBrush>
    <SolidColorBrush x:Key="TableHeadingForegroundBrush">#4A4A4A</SolidColorBrush>
    <SolidColorBrush x:Key="EmptyStateMessageForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="CardTitleForegroundBrush">#4A4A4A</SolidColorBrush>
    <SolidColorBrush x:Key="CardSubtitleForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="CardMetadataForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="DetailHeaderBackgroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="DetailHeaderBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="DetailStatisticDividerBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="DetailTitleForegroundBrush">#4A4A4A</SolidColorBrush>
    <SolidColorBrush x:Key="DetailSubtitleForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="DetailStatisticLabelForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="DetailStatisticValueForegroundBrush">#4A4A4A</SolidColorBrush>
    <SolidColorBrush x:Key="DetailStatisticUnitForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="DetailFieldLabelForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="DetailFieldValueForegroundBrush">#4A4A4A</SolidColorBrush>
    <SolidColorBrush x:Key="DetailLinkForegroundBrush">#F472B6</SolidColorBrush>
    <SolidColorBrush x:Key="PaginationTextForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="RibbonForegroundBrush">#4A4A4A</SolidColorBrush>
    <SolidColorBrush x:Key="MetadataTagBackgroundBrush">#FFF5F7</SolidColorBrush>
    <SolidColorBrush x:Key="MetadataTagBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="MetadataDividerBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="EmbeddedPanelBackgroundBrush">#FFF5F7</SolidColorBrush>
    <SolidColorBrush x:Key="SummaryPanelBackgroundBrush">#FFF5F7</SolidColorBrush>
    <SolidColorBrush x:Key="ListItemDividerBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="ListItemPrimaryForegroundBrush">#4A4A4A</SolidColorBrush>
    <SolidColorBrush x:Key="ListItemSecondaryForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="PatternPreviewPrimaryForegroundBrush">#4A4A4A</SolidColorBrush>
    <SolidColorBrush x:Key="PatternPreviewSecondaryForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="PatternPreviewMetadataForegroundBrush">#6B7280</SolidColorBrush>
    <SolidColorBrush x:Key="ProjectWoolPrimaryForegroundBrush">#4A4A4A</SolidColorBrush>
    <SolidColorBrush x:Key="ProjectWoolMetadataForegroundBrush">#6B7280</SolidColorBrush>

    <!-- Notifications -->
    <SolidColorBrush x:Key="NotificationTitleForegroundBrush">#4A4A4A</SolidColorBrush>
    <SolidColorBrush x:Key="NotificationMessageForegroundBrush">#4A4A4A</SolidColorBrush>
    <SolidColorBrush x:Key="NotificationIconForegroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="NotificationDismissForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="NotificationDismissHoverForegroundBrush">#4A4A4A</SolidColorBrush>
    <SolidColorBrush x:Key="NotificationSuccessAccentBrush">#16A34A</SolidColorBrush>
    <SolidColorBrush x:Key="NotificationSuccessBackgroundBrush">#ECFDF5</SolidColorBrush>
    <SolidColorBrush x:Key="NotificationSuccessBorderBrush">#BBF7D0</SolidColorBrush>
    <SolidColorBrush x:Key="NotificationWarningAccentBrush">#D97706</SolidColorBrush>
    <SolidColorBrush x:Key="NotificationWarningBackgroundBrush">#FFFBEB</SolidColorBrush>
    <SolidColorBrush x:Key="NotificationWarningBorderBrush">#FDE68A</SolidColorBrush>
    <SolidColorBrush x:Key="NotificationErrorAccentBrush">#DC2626</SolidColorBrush>
    <SolidColorBrush x:Key="NotificationErrorBackgroundBrush">#FEF2F2</SolidColorBrush>
    <SolidColorBrush x:Key="NotificationErrorBorderBrush">#FECACA</SolidColorBrush>
    <SolidColorBrush x:Key="NotificationInfoAccentBrush">#2563EB</SolidColorBrush>
    <SolidColorBrush x:Key="NotificationInfoBackgroundBrush">#EFF6FF</SolidColorBrush>
    <SolidColorBrush x:Key="NotificationInfoBorderBrush">#BFDBFE</SolidColorBrush>

    <!-- Valeurs numériques -->
    <CornerRadius x:Key="DefaultCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="LargeCornerRadius">16</CornerRadius>
    <Thickness x:Key="DefaultPadding">16,8</Thickness>
    <Thickness x:Key="LargePadding">20,12</Thickness>
</ResourceDictionary>
