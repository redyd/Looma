<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- global theme -->
    <Color x:Key="SystemAccentColor">#F472B6</Color>
    <Color x:Key="SystemAccentColorLight1">#F9A8D4</Color>
    <Color x:Key="SystemAccentColorLight2">#FCE7F3</Color>
    <Color x:Key="SystemAccentColorDark1">#DB2777</Color>
    <Color x:Key="SystemAccentColorDark2">#9D174D</Color>

    <!-- Couleurs principales - Rose pastel -->
    <SolidColorBrush x:Key="PrimaryBrush">#F9A8D4</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryDarkBrush">#F472B6</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryLightBrush">#FCE7F3</SolidColorBrush>

    <!-- Couleurs secondaires -->
    <SolidColorBrush x:Key="SecondaryBrush">#DDA0DD</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush">#FFB6C1</SolidColorBrush>

    <!-- Couleurs de texte -->
    <SolidColorBrush x:Key="TextPrimaryBrush">#4A4A4A</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondaryBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="TextWhiteBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="TextOnPrimaryBrush">#831843</SolidColorBrush>

    <!-- Couleurs de fond -->
    <SolidColorBrush x:Key="BackgroundBrush">#FFF5F7</SolidColorBrush>
    <SolidColorBrush x:Key="BackgroundHoverBrush">#FDF2F8</SolidColorBrush>
    <SolidColorBrush x:Key="BackgroundCardBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="TransparentBrush">Transparent</SolidColorBrush>

    <!-- Couleurs d'état -->
    <SolidColorBrush x:Key="SuccessBrush">#A7F3D0</SolidColorBrush>
    <SolidColorBrush x:Key="WarningBrush">#FED7AA</SolidColorBrush>
    <SolidColorBrush x:Key="ErrorBrush">#FECACA</SolidColorBrush>
    <SolidColorBrush x:Key="InfoBrush">#BFDBFE</SolidColorBrush>

    <!-- Bordures et séparateurs -->
    <SolidColorBrush x:Key="BorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="DividerBrush">#FCE7F3</SolidColorBrush>

    <!-- Boutons -->
    <SolidColorBrush x:Key="CancelButtonForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="CancelButtonBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="CancelButtonHoverBackgroundBrush">#FDF2F8</SolidColorBrush>
    <SolidColorBrush x:Key="CancelButtonHoverBorderBrush">#F472B6</SolidColorBrush>
    <SolidColorBrush x:Key="DangerButtonBackgroundBrush">#FEF2F2</SolidColorBrush>
    <SolidColorBrush x:Key="DangerButtonForegroundBrush">#EF4444</SolidColorBrush>
    <SolidColorBrush x:Key="DangerButtonBorderBrush">#FECACA</SolidColorBrush>
    <SolidColorBrush x:Key="DangerButtonHoverBackgroundBrush">#FEE2E2</SolidColorBrush>
    <SolidColorBrush x:Key="DangerSolidButtonBackgroundBrush">#EF4444</SolidColorBrush>
    <SolidColorBrush x:Key="DangerSolidButtonHoverBackgroundBrush">#DC2626</SolidColorBrush>
    <SolidColorBrush x:Key="PaginationButtonForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="PaginationButtonHoverForegroundBrush">#F472B6</SolidColorBrush>
    <SolidColorBrush x:Key="SubmitButtonBackgroundBrush">#7C3AED</SolidColorBrush>
    <SolidColorBrush x:Key="SubmitButtonForegroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="SubmitButtonHoverBackgroundBrush">#6D28D9</SolidColorBrush>
    <SolidColorBrush x:Key="SubmitButtonDisabledBackgroundBrush">#F3E8FF</SolidColorBrush>

    <!-- Formulaires -->
    <SolidColorBrush x:Key="FormDividerBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="FormControlBackgroundBrush">#FFF5F7</SolidColorBrush>
    <SolidColorBrush x:Key="FormControlBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="FormControlForegroundBrush">#4A4A4A</SolidColorBrush>
    <SolidColorBrush x:Key="FormControlHoverBorderBrush">#F472B6</SolidColorBrush>
    <SolidColorBrush x:Key="FormControlFocusBorderBrush">#7C3AED</SolidColorBrush>
    <SolidColorBrush x:Key="ColorPickerContainerBackgroundBrush">#FFF5F7</SolidColorBrush>
    <SolidColorBrush x:Key="ColorPickerContainerBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="RequiredFieldForegroundBrush">#EF4444</SolidColorBrush>

    <!-- Surfaces et listes -->
    <SolidColorBrush x:Key="InteractiveCardHoverBackgroundBrush">#FDF2F8</SolidColorBrush>
    <SolidColorBrush x:Key="InteractiveCardHoverBorderBrush">#F472B6</SolidColorBrush>
    <SolidColorBrush x:Key="SelectionRowBackgroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="SelectionRowBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="SelectionRowHoverBackgroundBrush">#FDF2F8</SolidColorBrush>
    <SolidColorBrush x:Key="SelectionRowSelectedBackgroundBrush">#FDF2F8</SolidColorBrush>
    <SolidColorBrush x:Key="SelectionRowSelectedBorderBrush">#F472B6</SolidColorBrush>
    <SolidColorBrush x:Key="TableHeaderBackgroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="TableHeaderBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="TableRowBackgroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="TableRowBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="LinkedRowBackgroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="LinkedRowBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="LinkedRowHoverBackgroundBrush">#FDF2F8</SolidColorBrush>
    <SolidColorBrush x:Key="LinkedRowHoverBorderBrush">#F472B6</SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceCardBackgroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceCardBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="SurfacePanelBackgroundBrush">#FFF5F7</SolidColorBrush>
    <SolidColorBrush x:Key="SurfacePanelBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceChipBackgroundBrush">#FFF5F7</SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceChipBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="EmptyStateBackgroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="EmptyStateBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="EmptyStateTitleForegroundBrush">#F472B6</SolidColorBrush>
    <SolidColorBrush x:Key="AlertErrorBackgroundBrush">#FEF2F2</SolidColorBrush>
    <SolidColorBrush x:Key="AlertErrorBorderBrush">#FECACA</SolidColorBrush>

    <!-- Navigation -->
    <SolidColorBrush x:Key="TabForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="TabHoverBackgroundBrush">#FDF2F8</SolidColorBrush>
    <SolidColorBrush x:Key="TabSelectedBackgroundBrush">#F9A8D4</SolidColorBrush>
    <SolidColorBrush x:Key="TabSelectedForegroundBrush">#831843</SolidColorBrush>
    <SolidColorBrush x:Key="TabSelectedHoverBackgroundBrush">#FCE7F3</SolidColorBrush>

    <!-- Badges d'entites -->
    <SolidColorBrush x:Key="ProjectStatusWishlistBrush">#F9A8D4</SolidColorBrush>
    <SolidColorBrush x:Key="ProjectStatusInProgressBrush">#FDBA74</SolidColorBrush>
    <SolidColorBrush x:Key="ProjectStatusFinishedBrush">#86EFAC</SolidColorBrush>
    <SolidColorBrush x:Key="ProjectStatusPausedBrush">#FCA5A5</SolidColorBrush>
    <SolidColorBrush x:Key="PatternTypeCrochetBrush">#F9A8D4</SolidColorBrush>
    <SolidColorBrush x:Key="PatternTypeTunisianCrochetBrush">#93C5FD</SolidColorBrush>
    <SolidColorBrush x:Key="PatternTypeTricotBrush">#C4A484</SolidColorBrush>
    <SolidColorBrush x:Key="ProjectFormWarningForegroundBrush">#991B1B</SolidColorBrush>

    <!-- Vues detaillees -->
    <SolidColorBrush x:Key="DetailHeaderBackgroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="DetailHeaderBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="DetailStatsDividerBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="DetailInformationAccentBrush">#F472B6</SolidColorBrush>
    <SolidColorBrush x:Key="PaginationInfoForegroundBrush">#9CA3AF</SolidColorBrush>
    <SolidColorBrush x:Key="EntityListTitleForegroundBrush">#4A4A4A</SolidColorBrush>
    <SolidColorBrush x:Key="WoolListTagBackgroundBrush">#FFF5F7</SolidColorBrush>
    <SolidColorBrush x:Key="WoolListTagBorderBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="WoolListDividerBrush">#F3E8FF</SolidColorBrush>
    <SolidColorBrush x:Key="DocumentFormItemBackgroundBrush">#FFF5F7</SolidColorBrush>
    <SolidColorBrush x:Key="ProjectFinishSummaryBackgroundBrush">#FFF5F7</SolidColorBrush>
    <SolidColorBrush x:Key="DocumentListDividerBrush">#F3E8FF</SolidColorBrush>

    <!-- Valeurs numériques -->
    <CornerRadius x:Key="DefaultCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="LargeCornerRadius">16</CornerRadius>
    <Thickness x:Key="DefaultPadding">16,8</Thickness>
    <Thickness x:Key="LargePadding">20,12</Thickness>
</ResourceDictionary>
