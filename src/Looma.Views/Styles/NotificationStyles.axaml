<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Border.notification-toast">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="BoxShadow" Value="0 10 24 0 #22000000"/>
        <Setter Property="Width" Value="360"/>
        <Setter Property="MaxWidth" Value="420"/>
        <Setter Property="MinHeight" Value="78"/>
    </Style>

    <Style Selector="TextBlock.notification-title">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="TextBlock.notification-message">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Opacity" Value="0.88"/>
    </Style>

    <Style Selector="Button.notification-dismiss">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="Button.notification-dismiss:pointerover">
        <Setter Property="Background" Value="#14000000"/>
    </Style>

</Styles>
