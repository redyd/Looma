<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Border.interactive-card:pointerover">
        <Setter Property="Background" Value="{DynamicResource InteractiveCardHoverBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InteractiveCardHoverBorderBrush}" />
    </Style>

    <Style Selector="Border.project-status-ribbon">
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="12 12 0 0" />
    </Style>

    <Style Selector="Border.project-status-ribbon.status-wishlist">
        <Setter Property="Background" Value="{DynamicResource StatusWishlistRibbonBackgroundBrush}" />
    </Style>

    <Style Selector="Border.project-status-ribbon.status-in-progress">
        <Setter Property="Background" Value="{DynamicResource StatusInProgressRibbonBackgroundBrush}" />
    </Style>

    <Style Selector="Border.project-status-ribbon.status-finished">
        <Setter Property="Background" Value="{DynamicResource StatusFinishedRibbonBackgroundBrush}" />
    </Style>

    <Style Selector="Border.project-status-ribbon.status-paused">
        <Setter Property="Background" Value="{DynamicResource StatusPausedRibbonBackgroundBrush}" />
    </Style>

    <Style Selector="Border.pattern-type-ribbon">
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="12 12 0 0" />
    </Style>

    <Style Selector="Border.pattern-type-ribbon.type-crochet">
        <Setter Property="Background" Value="{DynamicResource PatternCrochetRibbonBackgroundBrush}" />
    </Style>

    <Style Selector="Border.pattern-type-ribbon.type-tunisian-crochet">
        <Setter Property="Background" Value="{DynamicResource PatternTunisianCrochetRibbonBackgroundBrush}" />
    </Style>

    <Style Selector="Border.pattern-type-ribbon.type-tricot">
        <Setter Property="Background" Value="{DynamicResource PatternTricotRibbonBackgroundBrush}" />
    </Style>

</Styles>
