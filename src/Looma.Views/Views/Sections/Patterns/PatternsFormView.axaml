<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Looma.Views.Markup"
             xmlns:vm="using:Looma.Presentation.ViewModels.Sections.Patterns"
             xmlns:documents="clr-namespace:Looma.Presentation.ViewModels.Shared.Documents;assembly=Looma.Presentation"
             x:Class="Looma.Views.Views.Sections.Patterns.PatternsFormView"
             x:DataType="vm:PatternsFormViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center"
                    Margin="32"
                    Width="820"
                    MinWidth="820">

            <Border Classes="form-container" Width="820" MinWidth="820">
                <StackPanel Spacing="10">

                    <StackPanel Classes="form-header">
                        <TextBlock Classes="form-title" Text="{Binding Title}" />
                        <TextBlock Classes="form-subtitle"
                                   Text="{loc:Loc PatternsForm_Subtitle}" />
                    </StackPanel>

                    <Border Classes="form-section">
                        <StackPanel Spacing="0">
                            <TextBlock Classes="section-title"
                                       Text="{loc:Loc Common_Information}"
                                       Margin="0 0 0 16" />

                            <StackPanel Classes="form-field">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Classes="form-label" Text="{loc:Loc Common_Name}" />
                                    <TextBlock Classes="field-required" Text="*" />
                                </StackPanel>
                                <TextBox Classes="form-input"
                                         Text="{Binding Name}"
                                         PlaceholderText="{loc:Loc PatternsForm_NamePlaceholder}" />
                            </StackPanel>

                            <StackPanel Classes="form-field">
                                <TextBlock Classes="form-label" Text="{loc:Loc Common_Url}" />
                                <TextBox Classes="form-input"
                                         Text="{Binding Url}"
                                         PlaceholderText="{loc:Loc PatternsForm_UrlPlaceholder}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,16,*">
                                <StackPanel Grid.Column="0" Classes="form-field">
                                    <TextBlock Classes="form-label" Text="{loc:Loc Common_BeginDate}" />
                                    <DatePicker SelectedDate="{Binding BeginDate, Mode=TwoWay}"
                                                Classes="form-input" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Classes="form-field">
                                    <TextBlock Classes="form-label" Text="{loc:Loc Common_EndDate}" />
                                    <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                                Classes="form-input" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Classes="form-field">
                                <TextBlock Classes="form-label" Text="{loc:Loc Common_Note}" />
                                <TextBox Classes="form-input"
                                         Text="{Binding Note}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Padding="10"
                                         Height="180"
                                         VerticalContentAlignment="Top"
                                         PlaceholderText="{loc:Loc PatternsForm_NotePlaceholder}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <StackPanel Classes="form-field">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="form-label" Text="{loc:Loc Common_PatternType}" />
                            <TextBlock Classes="field-required" Text="*" />
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding PatternTypes}"
                                  SelectedItem="{Binding Type, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayName}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Classes="form-field">
                        <CheckBox Content="{loc:Loc PatternsForm_PersonalProject}"
                                  IsChecked="{Binding IsPersonal, Mode=TwoWay}" />
                    </StackPanel>

                    <Border Classes="form-section" IsVisible="{Binding IsEditMode}">
                        <StackPanel Spacing="0">
                            <TextBlock Classes="section-title"
                                       Text="{loc:Loc PatternsForm_ExistingDocuments}"
                                       Margin="0 0 0 16" />

                            <TextBlock Classes="form-hint"
                                       Text="{loc:Loc PatternsForm_EditExistingDocuments}"
                                       Margin="0 0 0 12" />

                            <TextBlock Text="{loc:Loc PatternsForm_NoExistingDocument}"
                                       Classes="form-hint"
                                       IsVisible="{Binding !Documents.ExistingDocuments.Count}" />

                            <ItemsControl ItemsSource="{Binding Documents.ExistingDocuments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="documents:DocumentFormSummaryViewModel">
                                        <Border Classes="surface-panel"
                                                Margin="0 0 0 12"
                                                Padding="16"
                                                Background="{DynamicResource EmbeddedPanelBackgroundBrush}">
                                            <StackPanel Spacing="12">
                                                <StackPanel Classes="form-field">
                                                    <TextBlock Classes="form-label" Text="{loc:Loc Documents_NameDocument}" />
                                                    <TextBox Classes="form-input"
                                                             Text="{Binding Nickname}"
                                                             PlaceholderText="{loc:Loc Documents_DisplayNamePlaceholder}" />
                                                </StackPanel>

                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <StackPanel Grid.Column="0" Spacing="4">
                                                        <TextBlock Text="{Binding DetailText}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ListItemPrimaryForegroundBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding TypeDisplay}"
                                                                   Classes="form-hint"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <Button Grid.Column="1"
                                                            Content="{loc:Loc Common_Delete}"
                                                            Command="{Binding RemoveCommand}"
                                                            Classes="cancel-btn"
                                                            VerticalAlignment="Center" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="form-section">
                        <StackPanel Spacing="0">
                            <TextBlock Classes="section-title"
                                       Text="{loc:Loc PatternsForm_AddDocuments}"
                                       Margin="0 0 0 16" />

                            <TextBlock Classes="form-hint"
                                       Text="{loc:Loc PatternsForm_AddDocumentsHint}"
                                       Margin="0 0 0 12" />

                            <ItemsControl ItemsSource="{Binding Documents.NewDocuments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="documents:DocumentDraftViewModel">
                                        <Border Classes="surface-panel"
                                                Margin="0 0 0 12"
                                                Padding="16"
                                                Background="{DynamicResource EmbeddedPanelBackgroundBrush}">
                                            <StackPanel Spacing="12">
                                                <StackPanel Classes="form-field">
                                                    <TextBlock Classes="form-label" Text="{loc:Loc Documents_NameDocument}" />
                                                    <TextBox Classes="form-input"
                                                             Text="{Binding Nickname}"
                                                             PlaceholderText="{loc:Loc Documents_DisplayNamePlaceholder}" />
                                                </StackPanel>

                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <StackPanel Grid.Column="0" Spacing="4">
                                                        <TextBlock Text="{Binding SelectedFileName}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ListItemPrimaryForegroundBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding SelectedFileDirectory}"
                                                                   Classes="form-hint"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                Spacing="8"
                                                                VerticalAlignment="Center">
                                                        <Button Content="{loc:Loc Documents_ChooseFile}"
                                                                Command="{Binding BrowseFileCommand}"
                                                                Classes="form-submit" />
                                                        <Button Content="{loc:Loc Common_Delete}"
                                                                Command="{Binding RemoveCommand}"
                                                                Classes="cancel-btn" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="{loc:Loc Documents_NewDocument}"
                                    Command="{Binding Documents.AddDocumentCommand}"                                   
                                    Classes="form-submit"
                                    HorizontalAlignment="Left"
                                    MinWidth="160" />
                        </StackPanel>
                    </Border>

                    <StackPanel Classes="form-actions">
                        <Button Classes="cancel-btn"
                                Content="{loc:Loc Common_Cancel}"
                                Command="{Binding CancelCommand}" />
                        <Button Classes="form-submit"
                                Content="{Binding Title}"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
