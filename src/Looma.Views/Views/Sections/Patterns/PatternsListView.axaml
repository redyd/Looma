<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Looma.Views.Markup"
             xmlns:core="clr-namespace:Looma.Domain.Core;assembly=Looma.Domain"
             xmlns:vm="using:Looma.Presentation.ViewModels.Sections.Patterns"
             xmlns:userControls="clr-namespace:Looma.Views.UserControls"
             xmlns:patterns="clr-namespace:Looma.Presentation.ViewModels.Shared.Patterns;assembly=Looma.Presentation"
             x:Class="Looma.Views.Views.Sections.Patterns.PatternsListView"
             x:DataType="vm:PatternsListViewModel">

    <DockPanel Margin="32">

        <Grid DockPanel.Dock="Top" Margin="0 0 0 24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="1"
                     Classes="form-input"
                     Text="{Binding SearchQuery}"
                     PlaceholderText="{loc:Loc Patterns_SearchPlaceholder}"
                     VerticalContentAlignment="Center" />
        </Grid>

        <DockPanel DockPanel.Dock="Top"
                   Margin="0 0 0 20"
                   HorizontalSpacing="20">
            <TextBlock Text="{loc:Loc Patterns_Title}"
                       Classes="page-title"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right"
                    Command="{Binding OpenAddFormCommand}"
                    Classes="form-submit">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <LucideIcon Kind="BookPlus"
                                Size="16"
                                Foreground="{DynamicResource SubmitButtonIconForegroundBrush}"
                                VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Loc Patterns_AddPattern}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>

        <userControls:PaginationControl
            DockPanel.Dock="Bottom"
            IsVisible="{Binding !IsListEmpty}"
            PreviousPageCommand="{Binding PreviousPageCommand}"
            NextPageCommand="{Binding NextPageCommand}"
            HasPreviousPage="{Binding HasPreviousPage}"
            HasNextPage="{Binding HasNextPage}"
            PageInfo="{Binding PageInfo}" />

        <Grid>
            <Border IsVisible="{Binding IsSourceListEmpty}"
                    Classes="empty-state">
                <StackPanel Spacing="8"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{loc:Loc Patterns_NoPatternAtThisTime}"
                               Classes="empty-state-title" />

                    <TextBlock Text="{loc:Loc Patterns_CreateFirstPattern}"
                               Classes="empty-state-message" />
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding IsFilterResultEmpty}"
                    Classes="empty-state">
                <StackPanel Spacing="8"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{loc:Loc Patterns_NoPatternFound}"
                               Classes="empty-state-title" />

                    <TextBlock Text="{loc:Loc Common_TryEditSearch}"
                               Classes="empty-state-message" />
                </StackPanel>
            </Border>

            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding CurrentPageEntities}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="patterns:PatternSummaryViewModel">
                            <Button Classes="card-button"
                                    Command="{Binding OpenDetailCommand}"
                                    HorizontalAlignment="Left">
                                <Border Width="240"
                                        Height="176"
                                        Margin="8"
                                        Padding="0"
                                        Classes="surface-card interactive-card">
                                    <Grid RowDefinitions="Auto,*">
                                        <Border Grid.Row="0"
                                                Classes="pattern-type-ribbon"
                                                Classes.type-crochet="{Binding Pattern.Type, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static core:PatternType.Crochet}}"
                                                Classes.type-tunisian-crochet="{Binding Pattern.Type, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static core:PatternType.TunisianCrochet}}"
                                                Classes.type-tricot="{Binding Pattern.Type, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static core:PatternType.Tricot}}">
                                            <TextBlock Text="{Binding TypeDisplay}"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       Margin="16 0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource RibbonForegroundBrush}" />
                                        </Border>

                                        <Grid Grid.Row="1"
                                              Margin="16"
                                              RowDefinitions="Auto,*,Auto">
                                            <StackPanel Grid.Row="0" Spacing="4">
                                                <TextBlock Text="{Binding Pattern.Name}"
                                                           Classes="card-title"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Pattern.Url}"
                                                           Classes="card-subtitle"
                                                           IsVisible="{Binding HasUrl}"
                                                           FontSize="12"
                                                           Opacity="0.6"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        VerticalAlignment="Center">
                                                <Border Classes="surface-chip" Padding="8 3">
                                                    <TextBlock Text="{Binding DocumentCount, StringFormat='{}{0} doc(s)'}"
                                                               Classes="card-meta"
                                                               FontSize="11" />
                                                </Border>
                                                <Border Classes="surface-chip" Padding="8 3">
                                                    <TextBlock Text="{Binding ProjectCount, StringFormat='{}{0} projet(s)'}"
                                                               Classes="card-meta"
                                                               FontSize="11" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Spacing="2">
                                                <TextBlock Text="{Binding BeginDateDisplay, StringFormat='Début: {0}'}"
                                                           Classes="card-meta"
                                                           IsVisible="{Binding HasBeginDate}"
                                                           FontSize="11"
                                                           Opacity="0.65" />
                                                <TextBlock Text="{Binding EndDateDisplay, StringFormat='Fin: {0}'}"
                                                           Classes="card-meta"
                                                           IsVisible="{Binding HasEndDate}"
                                                           FontSize="11"
                                                           Opacity="0.65" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

    </DockPanel>
</UserControl>
