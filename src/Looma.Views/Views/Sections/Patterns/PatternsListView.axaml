<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Looma.Domain.Core;assembly=Looma.Domain"
             xmlns:vm="using:Looma.Presentation.ViewModels.Sections.Patterns"
             xmlns:patterns="clr-namespace:Looma.Presentation.ViewModels.Shared.Patterns;assembly=Looma.Presentation"
             x:Class="Looma.Views.Views.Sections.Patterns.PatternsListView"
             x:DataType="vm:PatternsListViewModel">

    <UserControl.Styles>
        <Style Selector="Border.pattern-type-ribbon">
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="12 12 0 0" />
        </Style>

        <Style Selector="Border.pattern-type-ribbon.type-crochet">
            <Setter Property="Background" Value="#F9A8D4" />
        </Style>

        <Style Selector="Border.pattern-type-ribbon.type-tunisian-crochet">
            <Setter Property="Background" Value="#93C5FD" />
        </Style>

        <Style Selector="Border.pattern-type-ribbon.type-tricot">
            <Setter Property="Background" Value="#C4A484" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="32">

        <Grid DockPanel.Dock="Top" Margin="0 0 0 24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="1"
                     Classes="form-input"
                     Text="{Binding SearchQuery}"
                     PlaceholderText="Rechercher par nom, url ou note..."
                     VerticalContentAlignment="Center" />
        </Grid>

        <DockPanel DockPanel.Dock="Top"
                   Margin="0 0 0 20"
                   HorizontalSpacing="20">
            <TextBlock Text="Mes patrons"
                       Classes="page-title"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right"
                    Content="+ Ajouter un patron"
                    Command="{Binding OpenAddFormCommand}"
                    Classes="form-submit" />
        </DockPanel>

        <Border DockPanel.Dock="Bottom"
                IsVisible="{Binding !IsListEmpty}"
                Margin="0 16 0 0"
                Padding="16 10"
                CornerRadius="8"
                Background="{StaticResource BackgroundCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="12">
                <Button Content="←"
                        Command="{Binding PreviousPageCommand}"
                        Classes="form-cancel"
                        Width="36"
                        Height="36"
                        Padding="0" />
                <TextBlock Text="{Binding PageInfo}"
                           VerticalAlignment="Center"
                           FontSize="14" />
                <Button Content="→"
                        Command="{Binding NextPageCommand}"
                        Classes="form-cancel"
                        Width="36"
                        Height="36"
                        Padding="0" />
            </StackPanel>
        </Border>

        <Grid>
            <Border IsVisible="{Binding IsSourceListEmpty}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="32 24"
                    CornerRadius="18"
                    Background="{StaticResource BackgroundCardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Aucun patron pour l'instant"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryDarkBrush}" />

                    <TextBlock Text="Ajoute ton premier patron pour le retrouver facilement dans tes projets."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="13"
                               Opacity="0.65"
                               MaxWidth="360"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding IsFilterResultEmpty}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="32 24"
                    CornerRadius="18"
                    Background="{StaticResource BackgroundCardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Aucun patron trouvé"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryDarkBrush}" />

                    <TextBlock Text="Essaie de modifier ta recherche."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="13"
                               Opacity="0.65"
                               MaxWidth="360"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding CurrentPageEntities}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="patterns:PatternSummaryViewModel">
                            <Button Classes="card-button"
                                    Command="{Binding OpenDetailCommand}"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Left">
                                <Border Width="240"
                                        Height="176"
                                        Margin="8"
                                        Padding="0"
                                        Classes="surface-card">
                                    <Border.Styles>
                                        <Style Selector="Border.surface-card:pointerover">
                                            <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
                                        </Style>
                                    </Border.Styles>

                                    <Grid RowDefinitions="Auto,*">
                                        <Border Grid.Row="0"
                                                Classes="pattern-type-ribbon"
                                                Classes.type-crochet="{Binding Pattern.Type, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static core:PatternType.Crochet}}"
                                                Classes.type-tunisian-crochet="{Binding Pattern.Type, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static core:PatternType.TunisianCrochet}}"
                                                Classes.type-tricot="{Binding Pattern.Type, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static core:PatternType.Tricot}}">
                                            <TextBlock Text="{Binding TypeDisplay}"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       Margin="16 0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                        </Border>

                                        <Grid Grid.Row="1"
                                              Margin="16"
                                              RowDefinitions="Auto,*,Auto">
                                            <StackPanel Grid.Row="0" Spacing="4">
                                                <TextBlock Text="{Binding Pattern.Name}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Pattern.Url}"
                                                           IsVisible="{Binding HasUrl}"
                                                           FontSize="12"
                                                           Opacity="0.6"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        VerticalAlignment="Center">
                                                <Border Classes="surface-chip" Padding="8 3">
                                                    <TextBlock Text="{Binding DocumentCount, StringFormat='{}{0} doc(s)'}"
                                                               FontSize="11" />
                                                </Border>
                                                <Border Classes="surface-chip" Padding="8 3">
                                                    <TextBlock Text="{Binding ProjectCount, StringFormat='{}{0} projet(s)'}"
                                                               FontSize="11" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Spacing="2">
                                                <TextBlock Text="{Binding BeginDateDisplay, StringFormat='Début: {0}'}"
                                                           IsVisible="{Binding HasBeginDate}"
                                                           FontSize="11"
                                                           Opacity="0.65" />
                                                <TextBlock Text="{Binding EndDateDisplay, StringFormat='Fin: {0}'}"
                                                           IsVisible="{Binding HasEndDate}"
                                                           FontSize="11"
                                                           Opacity="0.65" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

    </DockPanel>
</UserControl>
