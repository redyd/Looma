<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Looma.Presentation.ViewModels.Sections.Patterns"
    xmlns:controls="clr-namespace:Looma.Views.UserControls"
    xmlns:documents="clr-namespace:Looma.Presentation.ViewModels.Sections.Documents;assembly=Looma.Presentation"
    xmlns:patterns="clr-namespace:Looma.Presentation.ViewModels.Shared.Patterns;assembly=Looma.Presentation"
    x:Class="Looma.Views.Views.Sections.Patterns.PatternsDetailView"
    x:DataType="vm:PatternsDetailViewModel"
>

    <DockPanel>

        <controls:DetailHeader
            DockPanel.Dock="Top"
            GoBackCommand="{Binding GoBackCommand}"
            EditCommand="{Binding EditCommand}"
            DeleteCommand="{Binding ConfirmDeleteCommand}"
        >

            <controls:DetailHeader.TitleContent>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <TextBlock
                        Text="{Binding Name}"
                        FontSize="20"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                    />
                    <TextBlock
                        Text="{Binding Url}"
                        FontSize="14"
                        Opacity="0.5"
                        HorizontalAlignment="Center"
                    />
                </StackPanel>
            </controls:DetailHeader.TitleContent>

        </controls:DetailHeader>



        <ScrollViewer>
            <StackPanel Margin="32" Spacing="16">

                <controls:DetailInformations
                    InfoTitle="Informations"
                    InfoIconKind="BadgeInfo"
                    Stats="{Binding DetailStats}"
                    Infos="{Binding DetailInfos}"
                />

                <Grid ColumnDefinitions="*,16,*">

                    <StackPanel Grid.Column="0" Spacing="16">
                        <Border Classes="form-section" MinHeight="360">
                            <Grid RowDefinitions="Auto,12,*,12,Auto">
                                <TextBlock
                                    Grid.Row="0"
                                    Classes="section-title"
                                    Text="Note"
                                />
                                <TextBox
                                    Grid.Row="2"
                                    Classes="form-input"
                                    Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Aucune note."
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    Height="NaN"
                                    MinHeight="240"
                                    Padding="12 10"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Top"
                                />
                                <Button
                                    Grid.Row="4"
                                    Content="Modifier la note"
                                    Command="{Binding SaveNoteCommand}"
                                    Classes="form-submit"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                />
                            </Grid>
                        </Border>

                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="16">

                        <Border Classes="form-section">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    Classes="section-title"
                                    Text="Documents liés"
                                />
                                <TextBlock
                                    Text="Aucun document"
                                    Classes="form-hint"
                                    IsVisible="{Binding !HasDocuments}"
                                />
                                <ItemsControl
                                    ItemsSource="{Binding Documents}"
                                    IsVisible="{Binding HasDocuments}"
                                >
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="0" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate
                                            x:DataType="documents:DocumentSummaryViewModel"
                                        >
                                            <StackPanel>
                                                <Grid
                                                    ColumnDefinitions="*,140,120,Auto"
                                                    MinHeight="56"
                                                >
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Text="{Binding Document.Nickname}"
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        VerticalAlignment="Center"
                                                        TextTrimming="CharacterEllipsis"
                                                    />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{Binding TypeDisplay}"
                                                        FontSize="13"
                                                        Opacity="0.7"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                    />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Text="{Binding SizeDisplay}"
                                                        FontSize="13"
                                                        Opacity="0.7"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                    />
                                                    <Button
                                                        Grid.Column="3"
                                                        Content="Ouvrir"
                                                        Command="{Binding OpenCommand}"
                                                        Classes="cancel-btn"
                                                        MinWidth="80"
                                                        VerticalAlignment="Center"
                                                    />
                                                </Grid>
                                                <Border
                                                    Height="1"
                                                    Background="{StaticResource BorderBrush}"
                                                    Opacity="0.2"
                                                    Margin="0 2 0 2"
                                                />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="form-section">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    Classes="section-title"
                                    Text="Projets liés"
                                />
                                <TextBlock
                                    Text="Aucun projet"
                                    Classes="form-hint"
                                    IsVisible="{Binding !HasProjects}"
                                />
                                <ItemsControl
                                    ItemsSource="{Binding Projects}"
                                    IsVisible="{Binding HasProjects}"
                                >
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate
                                            x:DataType="patterns:PatternProjectViewModel"
                                        >
                                            <Button
                                                Classes="card-button"
                                                Command="{Binding OpenCommand}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                            >
                                                <Border
                                                    Padding="12 10"
                                                    Classes="linked-row"
                                                >
                                                    <Grid
                                                        ColumnDefinitions="*,Auto"
                                                        ColumnSpacing="16"
                                                    >
                                                        <TextBlock
                                                            Text="{Binding Name}"
                                                            FontWeight="SemiBold"
                                                            VerticalAlignment="Center"
                                                        />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Text="{Binding StatusDisplay}"
                                                            VerticalAlignment="Center"
                                                            Opacity="0.75"
                                                        />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                </Grid>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
