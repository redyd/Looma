<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Looma.Presentation.ViewModels.Sections.Stocks"
             xmlns:controls="clr-namespace:Looma.Views.UserControls"
             x:Class="Looma.Views.Views.Sections.Stocks.WoolDetailView"
             x:DataType="vm:WoolDetailViewModel">
    
    <DockPanel>
        
        <controls:DetailHeader
            DockPanel.Dock="Top"
            GoBackCommand="{Binding GoBackCommand}"
            EditCommand="{Binding EditCommand}"
            DeleteCommand="{Binding ConfirmDeleteCommand}">
            
            <controls:DetailHeader.TitleContent>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse Width="16" Height="16" VerticalAlignment="Center"
                             Fill="{Binding Color, Converter={StaticResource HexToColor}}" />
                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Brand}" FontSize="14" Opacity="0.5"
                               VerticalAlignment="Center" />
                </StackPanel>
            </controls:DetailHeader.TitleContent>
            
        </controls:DetailHeader>

        <ScrollViewer>
            <StackPanel Spacing="16" Margin="32">
                
                <controls:DetailInformations
                    InfoTitle="🧶 Informations"
                    Stats="{Binding DetailStats}"
                    Infos="{Binding DetailInfos}" />

                <!-- Ligne 2 : tableau stock -->
                <Border Classes="form-section">
                    <StackPanel Spacing="16">

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>