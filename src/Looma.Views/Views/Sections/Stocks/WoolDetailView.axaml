<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Looma.Views.Markup"
             xmlns:vm="using:Looma.Presentation.ViewModels.Sections.Stocks"
             xmlns:controls="clr-namespace:Looma.Views.UserControls"
             x:Class="Looma.Views.Views.Sections.Stocks.WoolDetailView"
             x:DataType="vm:WoolDetailViewModel">

    <DockPanel>

        <controls:DetailHeader
            DockPanel.Dock="Top"
            GoBackCommand="{Binding GoBackCommand}"
            EditCommand="{Binding EditCommand}"
            DeleteCommand="{Binding ConfirmDeleteCommand}">

            <controls:DetailHeader.TitleContent>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <controls:ColorPieControl Colors="{Binding Colors}"
                                              Width="20" Height="20"
                                              VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource DetailTitleForegroundBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Brand}" FontSize="14" Opacity="0.5"
                               Foreground="{DynamicResource DetailSubtitleForegroundBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </controls:DetailHeader.TitleContent>

        </controls:DetailHeader>

        <ScrollViewer>
            <StackPanel Spacing="16" Margin="32">

                <controls:DetailInformations
                    InfoTitle="Informations"
                    InfoIconKind="BadgeInfo"
                    Stats="{Binding DetailStats}"
                    Infos="{Binding DetailInfos}"
                    Image="{Binding Image}"/>

                <!-- Ligne 2 : formulaire d'ajout/retrait -->
                <Border Classes="form-section">
                    <StackPanel Spacing="20">

                        <StackPanel Classes="form-header" Margin="0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <LucideIcon
                                    Kind="FilePenLine"
                                    Size="18"
                                    Foreground="{DynamicResource DetailLinkForegroundBrush}"
                                    VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc WoolDetail_StockAdjustment}"
                                           Classes="section-title"
                                           FontSize="16"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                                <TextBlock Text="{loc:Loc WoolDetail_AdjustStockSubtitle}" Classes="form-subtitle" />
                        </StackPanel>

                        <Border Classes="form-divider" Margin="0 4" />

                        <!-- Étape 1 : Choix du mode d'ajustement -->
                        <StackPanel Classes="form-field">
                            <TextBlock Text="{loc:Loc WoolDetail_AdjustmentMode}" Classes="form-label" Margin="0 0 0 4" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <RadioButton Content="{loc:Loc Common_BySkein}"
                                             Cursor="Hand"
                                             IsChecked="{Binding AdjustmentMode, Converter={StaticResource EnumToBool}, ConverterParameter=ByBall}" />
                                <RadioButton Content="{loc:Loc Common_ByWeight}"
                                             Cursor="Hand"
                                             IsChecked="{Binding AdjustmentMode, Converter={StaticResource EnumToBool}, ConverterParameter=ByWeight}" />
                                <RadioButton Content="{loc:Loc Common_ByLength}"
                                             Cursor="Hand"
                                             IsChecked="{Binding AdjustmentMode, Converter={StaticResource EnumToBool}, ConverterParameter=ByLength}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Étape 2 : Saisie de la quantité -->
                        <StackPanel Classes="form-field">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{loc:Loc WoolDetail_QuantityToAdjust}" Classes="form-label" />
                                <TextBlock Text="*" Classes="field-required" />
                            </StackPanel>

                            <NumericUpDown Classes="form-numeric"
                                           Value="{Binding AdjustQuantity}"
                                           Minimum="0"
                                           Increment="1"
                                           FormatString="N2"
                                           HorizontalAlignment="Stretch" />

                            <TextBlock Text="{loc:Loc WoolDetail_PositiveValueHint}"
                                       Classes="form-hint" />
                        </StackPanel>

                        <!-- Étape 3 : Actions (Boutons Ajouter / Retirer) -->
                        <StackPanel Classes="form-actions" Margin="0 8 0 0">

                            <Button Classes="danger-btn-solid"
                                    IsEnabled="{Binding CanAdjust}"
                                    Command="{Binding AdjustStockCommand}"
                                    CommandParameter="{x:False}"
                                    MinWidth="140">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <LucideIcon Kind="Trash2"
                                                Size="16"
                                                VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc WoolDetail_RemoveFromStock}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Bouton Ajouter (Principal/Violet) -->
                            <Button Classes="form-submit"
                                    IsEnabled="{Binding CanAdjust}"
                                    Command="{Binding AdjustStockCommand}"
                                    CommandParameter="{x:True}"
                                    MinWidth="140">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <LucideIcon Kind="PackagePlus"
                                                Size="16"
                                                VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc WoolDetail_AddToStock}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                        </StackPanel>

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
