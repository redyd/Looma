<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Looma.Presentation.ViewModels.Sections.Stocks"
             xmlns:userControls="clr-namespace:Looma.Views.UserControls"
             x:Class="Looma.Views.Views.Sections.Stocks.WoolListView"
             x:DataType="vm:WoolListViewModel">

    <DockPanel Margin="32">

        <!-- Barre de recherche centrée sur 2/3 de la largeur -->
        <Grid DockPanel.Dock="Top" Margin="0 0 0 24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="1"
                     Classes="form-input"
                     Text="{Binding SearchQuery}"
                     PlaceholderText="Rechercher par nom, marque, couleur, matière..."
                     VerticalContentAlignment="Center" />
        </Grid>

        <!-- Titre + bouton ajouter -->
        <DockPanel
            DockPanel.Dock="Top"
            Margin="0 0 0 20"
            HorizontalSpacing="20">
            <TextBlock Text="Mes laines"
                       Classes="page-title"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right"
                    Command="{Binding OpenAddFormCommand}"
                    Classes="form-submit">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <LucideIcon Kind="CircleFadingPlus" Size="16" VerticalAlignment="Center" />
                    <TextBlock Text="Ajouter une laine" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>

        <userControls:PaginationControl
            DockPanel.Dock="Bottom"
            IsVisible="{Binding !IsListEmpty}"
            PreviousPageCommand="{Binding PreviousPageCommand}"
            NextPageCommand="{Binding NextPageCommand}"
            HasPreviousPage="{Binding HasPreviousPage}"
            HasNextPage="{Binding HasNextPage}"
            PageInfo="{Binding PageInfo}" />

        <!-- Grille de cartes -->
        <Grid>
            <Border IsVisible="{Binding IsSourceListEmpty}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="32 24"
                    CornerRadius="18"
                    Background="{StaticResource BackgroundCardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Aucune laine pour l'instant"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryDarkBrush}" />

                    <TextBlock Text="Ajoute ta première laine pour suivre ton stock par couleur, matière et quantité."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="13"
                               Opacity="0.65"
                               MaxWidth="360"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding IsFilterResultEmpty}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="32 24"
                    CornerRadius="18"
                    Background="{StaticResource BackgroundCardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Aucune laine trouvée"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryDarkBrush}" />

                    <TextBlock Text="Essaie de modifier ta recherche."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="13"
                               Opacity="0.65"
                               MaxWidth="360"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding CurrentPageEntities}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WoolSummary">
                            <Button Classes="card-button"
                                    Command="{ReflectionBinding OpenDetailCommand}"
                                    CommandParameter="{Binding}"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Border Width="220"
                                        Margin="8"
                                        Padding="16"
                                        Classes="surface-card">
                                    <Border.Styles>
                                        <Style Selector="Button.card-button:pointerover">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                        </Style>
                                        <Style Selector="Button.card-button:pressed">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                        </Style>
                                        <Style Selector="Border:pointerover">
                                            <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
                                        </Style>
                                    </Border.Styles>

                                    <StackPanel Spacing="8">

                                        <!-- Pastille couleur + nom -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <userControls:ColorPieControl Colors="{Binding Wool.Colors}"
                                                                      Width="16" Height="16"
                                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Wool.Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Marque -->
                                        <TextBlock Text="{Binding Wool.Brand}"
                                                   FontSize="12"
                                                   Opacity="0.6" />

                                        <!-- Matière -->
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Padding="6 2" CornerRadius="4"
                                                    Background="{StaticResource BackgroundBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding Wool.Material}" FontSize="11" />
                                            </Border>
                                            <Border Padding="6 2" CornerRadius="4"
                                                    Background="{StaticResource BackgroundBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding Wool.BatchQuantityDisplay}"
                                                           FontSize="11" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Séparateur -->
                                        <Border Height="1"
                                                Background="{StaticResource BorderBrush}"
                                                Opacity="0.5"
                                                Margin="0 2 0 2" />

                                        <!-- Poids et longeur -->
                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="Poids" FontSize="10" Opacity="0.5" />
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="{Binding Wool.StockWeight, StringFormat='{}{0:N0}'}"
                                                               FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="g" FontSize="11" Opacity="0.5"
                                                               VerticalAlignment="Bottom" Margin="0 0 0 1" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="Longueur" FontSize="10" Opacity="0.5" />
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="{Binding Wool.StockLength}"
                                                               FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="m" FontSize="11" Opacity="0.5"
                                                               VerticalAlignment="Bottom" Margin="0 0 0 1" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

    </DockPanel>
</UserControl>
