<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Looma.Views.Markup"
             xmlns:vm="using:Looma.Presentation.ViewModels.Sections.Stocks"
             xmlns:userControls="clr-namespace:Looma.Views.UserControls"
             x:Class="Looma.Views.Views.Sections.Stocks.WoolListView"
             x:DataType="vm:WoolListViewModel">

    <DockPanel Margin="32">

        <!-- Barre de recherche centrée sur 2/3 de la largeur -->
        <Grid DockPanel.Dock="Top" Margin="0 0 0 24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="1"
                     Classes="form-input"
                     Text="{Binding SearchQuery}"
                     PlaceholderText="{loc:Loc Stocks_SearchPlaceholder}"
                     VerticalContentAlignment="Center" />
        </Grid>

        <!-- Titre + bouton ajouter -->
        <DockPanel
            DockPanel.Dock="Top"
            Margin="0 0 0 20"
            HorizontalSpacing="20">
            <TextBlock Text="{loc:Loc Stocks_Title}"
                       Classes="page-title"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right"
                    Command="{Binding OpenAddFormCommand}"
                    Classes="form-submit">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <LucideIcon Kind="PackagePlus"
                                Size="16"
                                Foreground="{DynamicResource SubmitButtonIconForegroundBrush}"
                                VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Loc Stocks_AddWool}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>

        <userControls:PaginationControl
            DockPanel.Dock="Bottom"
            IsVisible="{Binding !IsListEmpty}"
            PreviousPageCommand="{Binding PreviousPageCommand}"
            NextPageCommand="{Binding NextPageCommand}"
            HasPreviousPage="{Binding HasPreviousPage}"
            HasNextPage="{Binding HasNextPage}"
            PageInfo="{Binding PageInfo}" />

        <!-- Grille de cartes -->
        <Grid>
            <Border IsVisible="{Binding IsSourceListEmpty}"
                    Classes="empty-state">
                <StackPanel Spacing="8"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{loc:Loc Stocks_NoWoolAtThisTime}"
                               Classes="empty-state-title" />

                    <TextBlock Text="{loc:Loc Stocks_CreateFirstWool}"
                               Classes="empty-state-message" />
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding IsFilterResultEmpty}"
                    Classes="empty-state">
                <StackPanel Spacing="8"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{loc:Loc Stocks_NoWoolFound}"
                               Classes="empty-state-title" />

                    <TextBlock Text="{loc:Loc Common_TryEditSearch}"
                               Classes="empty-state-message" />
                </StackPanel>
            </Border>

            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding CurrentPageEntities}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WoolSummary">
                            <Button Classes="card-button"
                                    Command="{ReflectionBinding OpenDetailCommand}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand">
                                <Border Width="220"
                                        Margin="8"
                                        Padding="16"
                                        Classes="surface-card interactive-card">
                                    <StackPanel Spacing="8">

                                        <!-- Pastille couleur + nom -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <userControls:ColorPieControl Colors="{Binding Wool.Colors}"
                                                                      Width="16" Height="16"
                                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Wool.Name}"
                                                       Classes="card-title"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Marque -->
                                        <TextBlock Text="{Binding Wool.Brand}"
                                                   Classes="card-subtitle"
                                                   FontSize="12"
                                                   Opacity="0.6" />

                                        <!-- Matière -->
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Padding="6 2" CornerRadius="4"
                                                    Background="{DynamicResource MetadataTagBackgroundBrush}"
                                                    BorderBrush="{DynamicResource MetadataTagBorderBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding Wool.Material}"
                                                           Classes="card-meta"
                                                           FontSize="11" />
                                            </Border>
                                            <Border Padding="6 2" CornerRadius="4"
                                                    Background="{DynamicResource MetadataTagBackgroundBrush}"
                                                    BorderBrush="{DynamicResource MetadataTagBorderBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding BatchQuantityDisplay}"
                                                           Classes="card-meta"
                                                           FontSize="11" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Séparateur -->
                                        <Border Height="1"
                                                Background="{DynamicResource MetadataDividerBrush}"
                                                Opacity="0.5"
                                                Margin="0 2 0 2" />

                                        <!-- Poids et longeur -->
                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{loc:Loc Common_Weight}" Classes="card-meta" FontSize="10" Opacity="0.5" />
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="{Binding Wool.StockWeight, StringFormat='{}{0:N0}'}"
                                                               Classes="card-title"
                                                               FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="g" Classes="card-meta" FontSize="11" Opacity="0.5"
                                                               VerticalAlignment="Bottom" Margin="0 0 0 1" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{loc:Loc Common_Length}" Classes="card-meta" FontSize="10" Opacity="0.5" />
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="{Binding Wool.StockLength, StringFormat='{}{0:N0}'}"
                                                               Classes="card-title"
                                                               FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="m" Classes="card-meta" FontSize="11" Opacity="0.5"
                                                               VerticalAlignment="Bottom" Margin="0 0 0 1" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

    </DockPanel>
</UserControl>
