<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Looma.Presentation.ViewModels.Sections.Stocks"
             xmlns:entities="using:Looma.Domain.Entities"
             xmlns:cp="using:Avalonia.Controls"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             x:Class="Looma.Views.Views.Sections.Stocks.WoolFormView"
             x:DataType="vm:WoolFormViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center"
                    Margin="32"
                    Width="800"
                    MinWidth="800">

            <Border Classes="form-container" Width="800" MinWidth="800">
                <StackPanel Spacing="16">

                    <!-- En-tête -->
                    <StackPanel Classes="form-header">
                        <TextBlock Classes="form-title" Text="{Binding Title}" />
                        <TextBlock Classes="form-subtitle"
                                   Text="Renseignez les informations de la laine" />
                    </StackPanel>

                    <!-- Section détails -->
                    <Border Classes="form-section">
                        <StackPanel Spacing="0">

                            <TextBlock Classes="section-title"
                                       Text="Détails de la laine"
                                       Margin="0 0 0 16" />

                            <!-- Nom + Marque -->
                            <Grid ColumnDefinitions="*,16,*">
                                <StackPanel Grid.Column="0" Classes="form-field">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Classes="form-label" Text="Nom" />
                                        <TextBlock Classes="field-required" Text="*" />
                                    </StackPanel>
                                    <TextBox Classes="form-input"
                                             Text="{Binding Name}"
                                             PlaceholderText="Ex : Merino Extra Fine" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Classes="form-field">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Classes="form-label" Text="Marque" />
                                        <TextBlock Classes="field-required" Text="*" />
                                    </StackPanel>
                                    <TextBox Classes="form-input"
                                             Text="{Binding Brand}"
                                             PlaceholderText="Ex : Drops" />
                                </StackPanel>
                            </Grid>

                            <!-- Matière -->
                            <StackPanel Classes="form-field">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Classes="form-label" Text="Matière" />
                                    <TextBlock Classes="field-required" Text="*" />
                                </StackPanel>
                                <TextBox Classes="form-input"
                                         Text="{Binding Material}"
                                         PlaceholderText="Ex : Mérinos, Coton, Alpaga..." />
                            </StackPanel>

                            <!-- Poids + Longueur -->
                            <Grid ColumnDefinitions="*,16,*">
                                <StackPanel Grid.Column="0" Classes="form-field">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Classes="form-label" Text="Poids" />
                                        <TextBlock Classes="field-required" Text="*" />
                                        <TextBlock Classes="form-label" Opacity="0.5" Text="(g)" />
                                    </StackPanel>
                                    <TextBox Classes="form-input"
                                             Text="{Binding Weight}"
                                             PlaceholderText="Ex : 100" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Classes="form-field">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Classes="form-label" Text="Longueur" />
                                        <TextBlock Classes="field-required" Text="*" />
                                        <TextBlock Classes="form-label" Opacity="0.5" Text="(m)" />
                                    </StackPanel>
                                    <TextBox Classes="form-input"
                                             Text="{Binding Length}"
                                             PlaceholderText="Ex : 200" />
                                </StackPanel>
                            </Grid>

                            <!-- Taille d'aiguilles -->
                            <StackPanel Classes="form-field">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Classes="form-label" Text="Taille d'aiguilles" />
                                    <TextBlock Classes="field-required" Text="*" />
                                    <TextBlock Classes="form-label" Opacity="0.5" Text="(mm)" />
                                </StackPanel>
                                <ComboBox Classes="form-select"
                                          ItemsSource="{Binding NeedleRanges}"
                                          SelectedItem="{Binding SelectedNeedleRange}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WoolNeedleRangeSummary">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <Border Classes="form-section">
                        <StackPanel Spacing="0">

                            <TextBlock Classes="section-title"
                                       Text="Couleurs"
                                       Margin="0 0 0 16" />

                            <!-- Chips des couleurs sélectionnées -->
                            <ItemsControl ItemsSource="{Binding AllColors}"
                                          Margin="0 0 0 12"
                                          IsVisible="{Binding HasColors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="system:String">
                                        <Button
                                            Command="{Binding $parent[UserControl].((vm:WoolFormViewModel)DataContext).RemoveColorCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="color-chip"
                                            Margin="0 0 8 8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Ellipse Width="16" Height="16" VerticalAlignment="Center"
                                                         Fill="{Binding Converter={StaticResource HexToColor}}" />
                                                <TextBlock Text="{Binding}"
                                                           FontSize="11"
                                                           FontFamily="Consolas"
                                                           VerticalAlignment="Center" />
                                                <LucideIcon Kind="X"
                                                            Size="13"
                                                            VerticalAlignment="Center"
                                                            Opacity="0.6" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Picker + bouton ajouter -->
                            <StackPanel Classes="form-field">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Classes="form-label" Text="Couleur de la laine" />
                                </StackPanel>

                                <Border Classes="color-picker-container">
                                    <StackPanel Spacing="12">

                                        <cp:ColorPicker Color="{Binding SelectedColor, Mode=TwoWay}"
                                                        HorizontalAlignment="Stretch" />

                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Classes="form-hint"
                                                       Text="Aperçu :"
                                                       VerticalAlignment="Center"
                                                       Margin="0" />
                                            <Border Grid.Column="1"
                                                    Height="32"
                                                    Margin="12 0"
                                                    Classes="surface-panel">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding SelectedColor}" />
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SelectedColorHex}"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       FontFamily="Consolas"
                                                       Classes="form-hint"
                                                       Margin="0 0 12 0" />
                                            <Button Grid.Column="3"
                                                    Content="Ajouter"
                                                    Command="{Binding AddColorCommand}"
                                                    Classes="form-submit"
                                                    VerticalAlignment="Center" />
                                        </Grid>

                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- Boutons -->
                    <StackPanel Classes="form-actions">
                        <TextBlock Classes="form-error"
                                   Text="{Binding ErrorMessage}"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <Button Classes="form-cancel"
                                Content="Annuler"
                                Command="{Binding CancelCommand}" />
                        <Button Classes="form-submit"
                                Content="{Binding Title}"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
