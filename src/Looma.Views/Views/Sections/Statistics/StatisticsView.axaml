<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:vm="using:Looma.Presentation.ViewModels.Sections.Statistics"
             xmlns:local="using:Looma.Views.Views.Sections.Statistics"
             x:Class="Looma.Views.Views.Sections.Statistics.StatisticsView"
             x:DataType="vm:StatisticsViewModel">

    <DockPanel Margin="32">
        <DockPanel DockPanel.Dock="Top"
                   Margin="0 0 0 20"
                   HorizontalSpacing="20">
            <StackPanel Spacing="4">
                <TextBlock Text="Statistiques"
                           Classes="page-title" />
                <TextBlock Text="Suivi du stock et de l'activité des projets"
                           Classes="page-subtitle" />
            </StackPanel>

            <Button DockPanel.Dock="Right"
                    Classes="form-submit"
                    Command="{Binding LoadCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <LucideIcon Kind="RefreshCw"
                                Size="16"
                                Foreground="{DynamicResource SubmitButtonIconForegroundBrush}" />
                    <TextBlock Text="Actualiser" />
                </StackPanel>
            </Button>
        </DockPanel>

        <Border DockPanel.Dock="Top"
                Classes="surface-panel"
                Padding="16"
                Margin="0 0 0 18">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="8"
                  HorizontalAlignment="Left">
                <StackPanel Grid.Column="0" Classes="form-field" Margin="0" Width="150">
                    <TextBlock Text="Graphique" Classes="form-label" />
                    <ComboBox Classes="form-select"
                              ItemsSource="{Binding ChartOptions}"
                              SelectedItem="{Binding SelectedChart}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Classes="form-field" Margin="0" Width="140">
                    <TextBlock Text="Donnée" Classes="form-label" />
                    <ComboBox Classes="form-select"
                              ItemsSource="{Binding DataOptions}"
                              SelectedItem="{Binding SelectedData}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Classes="form-field" Margin="0" Width="180">
                    <TextBlock Text="Période" Classes="form-label" />
                    <ComboBox Classes="form-select"
                              ItemsSource="{Binding RangeOptions}"
                              SelectedItem="{Binding SelectedRange}" />
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Classes="form-field"
                            Margin="0"
                            Width="180"
                            IsVisible="{Binding ShowPatternTypeFilter}">
                    <TextBlock Text="Type de patron" Classes="form-label" />
                    <ComboBox Classes="form-select"
                              ItemsSource="{Binding PatternTypeOptions}"
                              SelectedItem="{Binding SelectedPatternType}" />
                </StackPanel>

                <StackPanel Grid.Column="4"
                            Classes="form-field"
                            Margin="0"
                            Width="150"
                            IsVisible="{Binding ShowPatternTypeFilter}">
                    <TextBlock Text="Statut" Classes="form-label" />
                    <ComboBox Classes="form-select"
                              ItemsSource="{Binding ProjectStatusOptions}"
                              SelectedItem="{Binding SelectedProjectStatus}" />
                </StackPanel>

                <StackPanel Grid.Column="5"
                            Classes="form-field"
                            Margin="0"
                            Width="160"
                            IsVisible="{Binding ShowProjectGroupingFilter}">
                    <TextBlock Text="Regroupement" Classes="form-label" />
                    <ComboBox Classes="form-select"
                              ItemsSource="{Binding ProjectGroupingOptions}"
                              SelectedItem="{Binding SelectedProjectGrouping}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Classes="surface-card"
                Padding="18"
                ClipToBounds="True">
            <Grid MinHeight="420"
                  RowDefinitions="*,Auto">
                <lvc:CartesianChart x:Name="LineChart"
                                    IsVisible="{Binding IsLineChart}"
                                    LegendPosition="Hidden" />

                <lvc:PieChart x:Name="PieChart"
                              IsVisible="{Binding IsPieChart}"
                              LegendPosition="Right" />

                <ItemsControl x:Name="LineLegend"
                              Grid.Row="1"
                              Margin="0 12 0 0"
                              IsVisible="{Binding IsLineChart}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:LineLegendItem">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        Margin="0 0 14 8">
                                <Border Width="22"
                                        Height="3"
                                        CornerRadius="2"
                                        Background="{Binding Brush}"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}"
                                           Classes="card-meta"
                                           FontSize="12"
                                           TextWrapping="NoWrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border IsVisible="{Binding !HasData}"
                        Grid.RowSpan="2"
                        Classes="empty-state">
                    <StackPanel Spacing="8"
                                HorizontalAlignment="Center">
                        <TextBlock Text="Aucune donnée"
                                   Classes="empty-state-title" />
                        <TextBlock Text="Modifie les filtres ou ajoute des mouvements de stock pour afficher un graphique."
                                   Classes="empty-state-message" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
