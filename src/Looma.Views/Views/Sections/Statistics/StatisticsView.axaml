<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:vm="using:Looma.Presentation.ViewModels.Sections.Statistics"
             x:Class="Looma.Views.Views.Sections.Statistics.StatisticsView"
             x:DataType="vm:StatisticsViewModel">

    <DockPanel Margin="32">
        <DockPanel DockPanel.Dock="Top"
                   Margin="0 0 0 20"
                   HorizontalSpacing="20">
            <StackPanel Spacing="4">
                <TextBlock Text="Statistiques"
                           Classes="page-title" />
                <TextBlock Text="Laine utilisée par référence"
                           Classes="page-subtitle" />
            </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Top"
                Classes="surface-panel"
                Padding="16"
                Margin="0 0 0 18">
            <Grid ColumnDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="8"
                  HorizontalAlignment="Left">
                <StackPanel Grid.Column="0"
                            Classes="form-field"
                            Margin="0"
                            Width="180">
                    <TextBlock Text="Période" Classes="form-label" />
                    <ComboBox Classes="form-select"
                              ItemsSource="{Binding RangeOptions}"
                              SelectedItem="{Binding SelectedRange}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Classes="form-field"
                            Margin="0"
                            Width="150">
                    <TextBlock Text="Unité" Classes="form-label" />
                    <ComboBox Classes="form-select"
                              ItemsSource="{Binding QuantityUnitOptions}"
                              SelectedItem="{Binding SelectedQuantityUnit}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Classes="form-field"
                            Margin="0"
                            Width="180">
                    <TextBlock Text="Type de patron" Classes="form-label" />
                    <ComboBox Classes="form-select"
                              ItemsSource="{Binding PatternTypeOptions}"
                              SelectedItem="{Binding SelectedPatternType}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Classes="surface-card"
                Padding="18"
                ClipToBounds="True">
            <Grid MinHeight="420">
                <lvc:CartesianChart x:Name="LineChart"
                                    LegendPosition="Hidden"
                                    PointerWheelChanged="OnChartPointerWheelChanged"
                                    PointerPressed="OnChartPointerPressed"
                                    PointerMoved="OnChartPointerMoved"
                                    PointerReleased="OnChartPointerReleased" />

                <Border IsVisible="{Binding !HasData}"
                        Classes="empty-state">
                    <StackPanel Spacing="8"
                                HorizontalAlignment="Center">
                        <TextBlock Text="Aucune donnée"
                                   Classes="empty-state-title" />
                        <TextBlock Text="Ajoute des mouvements de laine liés à des projets pour afficher l'évolution."
                                   Classes="empty-state-message" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
