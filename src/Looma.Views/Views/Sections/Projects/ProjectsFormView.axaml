<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Looma.Views.Markup"
             xmlns:vm="using:Looma.Presentation.ViewModels.Sections.Projects"
             xmlns:shared="clr-namespace:Looma.Presentation.ViewModels.Shared;assembly=Looma.Presentation"
             xmlns:projects="clr-namespace:Looma.Presentation.ViewModels.Shared.Projects;assembly=Looma.Presentation"
             xmlns:userControls="clr-namespace:Looma.Views.UserControls"
             x:Class="Looma.Views.Views.Sections.Projects.ProjectsFormView"
             x:DataType="vm:ProjectsFormViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center"
                    Margin="32"
                    Width="900"
                    MinWidth="900">

            <Border Classes="form-container" Width="900" MinWidth="900">
                <StackPanel Spacing="10">

                    <StackPanel Classes="form-header">
                        <TextBlock Classes="form-title" Text="{Binding Title}" />
                        <TextBlock Classes="form-subtitle"
                                   Text="{loc:Loc ProjectsForm_Subtitle}" />
                    </StackPanel>

                    <Border Classes="form-section">
                        <StackPanel Spacing="0">
                            <TextBlock Classes="section-title"
                                       Text="{loc:Loc Common_Information}"
                                       Margin="0 0 0 16" />

                            <StackPanel Classes="form-field">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Classes="form-label" Text="{loc:Loc Common_Name}" />
                                    <TextBlock Classes="field-required" Text="*" />
                                </StackPanel>
                                <TextBox Classes="form-input"
                                         Text="{Binding Name}"
                                         PlaceholderText="{loc:Loc ProjectsForm_NamePlaceholder}" />
                            </StackPanel>

                            <StackPanel Classes="form-field">
                                <TextBlock Classes="form-label" Text="{loc:Loc Common_Status}" />
                                <ComboBox ItemsSource="{Binding Statuses}"
                                          SelectedItem="{Binding Status, Mode=TwoWay}"
                                          Classes="form-select"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDisplayName}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,16,*">
                                <StackPanel Grid.Column="0" Classes="form-field">
                                    <TextBlock Classes="form-label" Text="{loc:Loc Common_BeginDate}" />
                                    <DatePicker SelectedDate="{Binding BeginDate, Mode=TwoWay}"
                                                Classes="form-input" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Classes="form-field">
                                    <TextBlock Classes="form-label" Text="{loc:Loc Common_EndDate}" />
                                    <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                                Classes="form-input" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Classes="form-field">
                                <TextBlock Classes="form-label" Text="{loc:Loc Common_Note}" />
                                <TextBox Classes="form-input"
                                         Text="{Binding Note}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Padding="10"
                                         Height="130"
                                         VerticalContentAlignment="Top"
                                         PlaceholderText="{loc:Loc ProjectsForm_NotePlaceholder}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="form-section">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Classes="section-title"
                                           Text="{loc:Loc Common_Images}" />
                                <Button Grid.Column="1"
                                        Classes="form-submit"
                                        Content="{loc:Loc ProjectsForm_AddImages}"
                                        Command="{Binding BrowseImagesCommand}" />
                            </Grid>

                            <TextBlock Classes="form-hint"
                                       Text="{loc:Loc ProjectsForm_ImageFormatsHint}" />

                            <TextBlock Text="{loc:Loc ProjectsForm_NoSelectedImage}"
                                       Classes="form-hint"
                                       IsVisible="{Binding !HasImages}" />

                            <ItemsControl ItemsSource="{Binding ExistingImages}"
                                          IsVisible="{Binding HasExistingImages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="projects:ProjectImageViewModel">
                                        <Border Classes="surface-panel"
                                                Padding="12"
                                                Margin="0 0 0 8">
                                            <Grid ColumnDefinitions="120,16,*,Auto">
                                                <Image Grid.Column="0"
                                                       Source="{Binding SourcePath, Converter={StaticResource StringToUri}}"
                                                       Width="120"
                                                       Height="90"
                                                       Stretch="UniformToFill" />
                                                <StackPanel Grid.Column="2"
                                                            Spacing="4"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding DetailText}"
                                                               Classes="form-hint"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="3"
                                                        Content="{loc:Loc Common_Remove}"
                                                        Command="{Binding RemoveCommand}"
                                                        Classes="cancel-btn"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding NewImages}"
                                          IsVisible="{Binding HasNewImages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="projects:ProjectImageDraftViewModel">
                                        <Border Classes="surface-panel"
                                                Padding="12"
                                                Margin="0 0 0 8">
                                            <Grid ColumnDefinitions="120,16,*,Auto">
                                                <Image Grid.Column="0"
                                                       Source="{Binding SourcePath, Converter={StaticResource StringToUri}}"
                                                       Width="120"
                                                       Height="90"
                                                       Stretch="UniformToFill" />
                                                <StackPanel Grid.Column="2"
                                                            Spacing="8"
                                                            VerticalAlignment="Center">
                                                    <TextBox Classes="form-input"
                                                             Text="{Binding Nickname}"
                                                             PlaceholderText="{loc:Loc ProjectsForm_ImageDisplayNamePlaceholder}" />
                                                    <TextBlock Text="{Binding SelectedFileName}"
                                                               Classes="form-hint"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="3"
                                                        Content="{loc:Loc Common_Remove}"
                                                        Command="{Binding RemoveCommand}"
                                                        Classes="cancel-btn"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="form-section">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="section-title" Text="{loc:Loc Common_Pattern}" />
                            <Grid ColumnDefinitions="*,16,220">
                                <StackPanel Grid.Column="0" Classes="form-field">
                                    <TextBlock Classes="form-label" Text="{loc:Loc ProjectsForm_SearchPattern}" />
                                    <TextBox Classes="form-input"
                                             Text="{Binding PatternSearchQuery}"
                                             PlaceholderText="{loc:Loc ProjectsForm_SearchPatternPlaceholder}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Classes="form-field">
                                    <TextBlock Classes="form-label" Text="{loc:Loc Common_PatternType}" />
                                    <ComboBox ItemsSource="{Binding PatternTypeFilters}"
                                              SelectedItem="{Binding SelectedPatternTypeFilter, Mode=TwoWay}"
                                              Classes="form-select"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="projects:ProjectPatternTypeFilterViewModel">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="6" IsVisible="{Binding HasSelectedPattern}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Classes="form-label"
                                               Text="{loc:Loc ProjectsForm_SelectedPattern}" />
                                    <Button Grid.Column="1"
                                            Content="{loc:Loc Common_Remove}"
                                            Command="{Binding ClearPatternCommand}"
                                            Classes="cancel-btn"
                                            Padding="10 4" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding SelectedPatterns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="projects:ProjectSelectablePatternViewModel">
                                            <Border Padding="12 10"
                                                    Classes="selection-row selected">
                                                <Grid ColumnDefinitions="*,130,130,110,110" ColumnSpacing="14">
                                                    <TextBlock Text="{Binding Pattern.Name}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PatternPreviewPrimaryForegroundBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding TypeDisplay}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource PatternPreviewSecondaryForegroundBrush}"
                                                               Opacity="0.8"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding OriginDisplay}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource PatternPreviewSecondaryForegroundBrush}"
                                                               Opacity="0.8"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding BeginDateDisplay}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource PatternPreviewMetadataForegroundBrush}"
                                                               Opacity="0.7"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding EndDateDisplay}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource PatternPreviewMetadataForegroundBrush}"
                                                               Opacity="0.7"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="0">
                                <Border Padding="12 10"
                                        Classes="table-header">
                                    <Grid ColumnDefinitions="*,130,130,110,110" ColumnSpacing="14">
                                        <TextBlock Text="{loc:Loc Common_Name}" Classes="table-heading" />
                                        <TextBlock Grid.Column="1" Text="{loc:Loc Common_Type}" Classes="table-heading" />
                                        <TextBlock Grid.Column="2" Text="{loc:Loc Common_Origin}" Classes="table-heading" />
                                        <TextBlock Grid.Column="3" Text="{loc:Loc Common_Begin}" Classes="table-heading" />
                                        <TextBlock Grid.Column="4" Text="{loc:Loc Common_End}" Classes="table-heading" />
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding PatternResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="projects:ProjectSelectablePatternViewModel">
                                            <Button Command="{Binding SelectCommand}"
                                                    Classes="card-button"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch">
                                                <Border Padding="12 10"
                                                        Classes="selection-row">
                                                    <Grid ColumnDefinitions="*,130,130,110,110" ColumnSpacing="14">
                                                        <TextBlock Text="{Binding Pattern.Name}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PatternPreviewPrimaryForegroundBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding TypeDisplay}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource PatternPreviewSecondaryForegroundBrush}"
                                                                   Opacity="0.8"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding OriginDisplay}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource PatternPreviewSecondaryForegroundBrush}"
                                                                   Opacity="0.8"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding BeginDateDisplay}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource PatternPreviewMetadataForegroundBrush}"
                                                                   Opacity="0.7"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding EndDateDisplay}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource PatternPreviewMetadataForegroundBrush}"
                                                                   Opacity="0.7"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Padding="12 18"
                                        Classes="table-empty-row"
                                        IsVisible="{Binding !PatternResults.Count}">
                                    <TextBlock Text="{loc:Loc Patterns_NoPatternToDisplay}"
                                               Classes="form-hint"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="form-section">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="section-title" Text="{loc:Loc Common_Wools}" />
                            <StackPanel Classes="form-field">
                                <TextBlock Classes="form-label" Text="{loc:Loc ProjectsForm_SmartSearch}" />
                                <TextBox Classes="form-input"
                                         Text="{Binding WoolSearchQuery}"
                                         PlaceholderText="{loc:Loc ProjectsForm_WoolSearchPlaceholder}" />
                            </StackPanel>

                            <StackPanel Spacing="6" IsVisible="{Binding HasSelectedWools}">
                                <TextBlock Classes="form-label" Text="{loc:Loc ProjectsForm_SelectedWools}" />
                                <ItemsControl ItemsSource="{Binding SelectedWools}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="projects:ProjectSelectableWoolViewModel">
                                            <Button Command="{Binding ToggleCommand}"
                                                    Classes="card-button"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch">
                                                <Border Padding="12 10"
                                                        Classes="selection-row selected">
                                                    <Grid ColumnDefinitions="28,*,130,130,110" ColumnSpacing="14">
                                                        <userControls:ColorPieControl
                                                            Grid.Column="0"
                                                            Colors="{Binding Wool.Colors}"
                                                            Width="16" Height="16"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Wool.Name}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ProjectWoolPrimaryForegroundBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Wool.Brand}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource ProjectWoolMetadataForegroundBrush}"
                                                                   Opacity="0.8"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding Wool.Material}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource ProjectWoolMetadataForegroundBrush}"
                                                                   Opacity="0.8"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding StockDisplay}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource ProjectWoolMetadataForegroundBrush}"
                                                                   Opacity="0.7"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="0">
                                <Border Padding="12 10"
                                        Classes="table-header">
                                    <Grid ColumnDefinitions="28,*,130,130,110" ColumnSpacing="14">
                                        <TextBlock Text="" />
                                        <TextBlock Grid.Column="1" Text="{loc:Loc Common_Name}" Classes="table-heading" />
                                        <TextBlock Grid.Column="2" Text="{loc:Loc Common_Brand}" Classes="table-heading" />
                                        <TextBlock Grid.Column="3" Text="{loc:Loc Common_Material}" Classes="table-heading" />
                                        <TextBlock Grid.Column="4" Text="{loc:Loc Common_Stock}" Classes="table-heading" />
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding WoolResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="projects:ProjectSelectableWoolViewModel">
                                            <Button Command="{Binding ToggleCommand}"
                                                    Classes="card-button"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch">
                                                <Border Padding="12 10"
                                                        Classes="selection-row">
                                                    <Grid ColumnDefinitions="28,*,130,130,110" ColumnSpacing="14">
                                                        <userControls:ColorPieControl
                                                            Grid.Column="0"
                                                            Colors="{Binding Wool.Colors}"
                                                            Width="20" Height="20"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Wool.Name}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ProjectWoolPrimaryForegroundBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Wool.Brand}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource ProjectWoolMetadataForegroundBrush}"
                                                                   Opacity="0.8"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding Wool.Material}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource ProjectWoolMetadataForegroundBrush}"
                                                                   Opacity="0.8"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding StockDisplay}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource ProjectWoolMetadataForegroundBrush}"
                                                                   Opacity="0.7"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Padding="12 18"
                                        Classes="table-empty-row"
                                        IsVisible="{Binding !WoolResults.Count}">
                                    <TextBlock Text="{loc:Loc Stocks_NoWoolToDisplay}"
                                               Classes="form-hint"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="alert-error"
                            Padding="12"
                            IsVisible="{Binding HasError}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningTextForegroundBrush}" />
                    </Border>

                    <StackPanel Classes="form-actions">
                        <Button Classes="cancel-btn"
                                Content="{loc:Loc Common_Cancel}"
                                Command="{Binding CancelCommand}" />
                        <Button Classes="form-submit"
                                Content="{Binding Title}"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
