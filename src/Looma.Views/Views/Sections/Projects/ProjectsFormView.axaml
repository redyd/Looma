<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Looma.Presentation.ViewModels.Sections.Projects"
             xmlns:shared="clr-namespace:Looma.Presentation.ViewModels.Shared;assembly=Looma.Presentation"
             xmlns:projects="clr-namespace:Looma.Presentation.ViewModels.Shared.Projects;assembly=Looma.Presentation"
             xmlns:userControls="clr-namespace:Looma.Views.UserControls"
             x:Class="Looma.Views.Views.Sections.Projects.ProjectsFormView"
             x:DataType="vm:ProjectsFormViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center"
                    Margin="32"
                    Width="900"
                    MinWidth="900">

            <Border Classes="form-container" Width="900" MinWidth="900">
                <StackPanel Spacing="10">

                    <StackPanel Classes="form-header">
                        <TextBlock Classes="form-title" Text="{Binding Title}" />
                        <TextBlock Classes="form-subtitle"
                                   Text="Renseignez le projet, le patron optionnel et les laines associées." />
                    </StackPanel>

                    <Border Classes="form-section">
                        <StackPanel Spacing="0">
                            <TextBlock Classes="section-title"
                                       Text="Informations"
                                       Margin="0 0 0 16" />

                            <StackPanel Classes="form-field">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Classes="form-label" Text="Nom" />
                                    <TextBlock Classes="field-required" Text="*" />
                                </StackPanel>
                                <TextBox Classes="form-input"
                                         Text="{Binding Name}"
                                         PlaceholderText="Ex : Pull d'hiver" />
                            </StackPanel>

                            <StackPanel Classes="form-field">
                                <TextBlock Classes="form-label" Text="Status" />
                                <ComboBox ItemsSource="{Binding Statuses}"
                                          SelectedItem="{Binding Status, Mode=TwoWay}"
                                          Classes="form-select"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDisplayName}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,16,*">
                                <StackPanel Grid.Column="0" Classes="form-field">
                                    <TextBlock Classes="form-label" Text="Date de début" />
                                    <DatePicker SelectedDate="{Binding BeginDate, Mode=TwoWay}"
                                                Classes="form-input" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Classes="form-field">
                                    <TextBlock Classes="form-label" Text="Date de fin" />
                                    <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                                Classes="form-input" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Classes="form-field">
                                <TextBlock Classes="form-label" Text="Note" />
                                <TextBox Classes="form-input"
                                         Text="{Binding Note}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Padding="10"
                                         Height="130"
                                         VerticalContentAlignment="Top"
                                         PlaceholderText="Notes de progression, ajustements, remarques..." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="form-section">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Classes="section-title"
                                           Text="Images" />
                                <Button Grid.Column="1"
                                        Classes="form-submit"
                                        Content="Ajouter des images"
                                        Command="{Binding BrowseImagesCommand}" />
                            </Grid>

                            <TextBlock Classes="form-hint"
                                       Text="PNG, JPG, WEBP, BMP ou GIF. Plusieurs images peuvent être sélectionnées en une fois." />

                            <TextBlock Text="Aucune image sélectionnée."
                                       Classes="form-hint"
                                       IsVisible="{Binding !HasImages}" />

                            <ItemsControl ItemsSource="{Binding ExistingImages}"
                                          IsVisible="{Binding HasExistingImages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="projects:ProjectImageViewModel">
                                        <Border Classes="surface-panel"
                                                Padding="12"
                                                Margin="0 0 0 8">
                                            <Grid ColumnDefinitions="120,16,*,Auto">
                                                <Image Grid.Column="0"
                                                       Source="{Binding SourcePath, Converter={StaticResource StringToUri}}"
                                                       Width="120"
                                                       Height="90"
                                                       Stretch="UniformToFill" />
                                                <StackPanel Grid.Column="2"
                                                            Spacing="4"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding DetailText}"
                                                               Classes="form-hint"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="3"
                                                        Content="Retirer"
                                                        Command="{Binding RemoveCommand}"
                                                        Classes="form-cancel"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding NewImages}"
                                          IsVisible="{Binding HasNewImages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="projects:ProjectImageDraftViewModel">
                                        <Border Classes="surface-panel"
                                                Padding="12"
                                                Margin="0 0 0 8">
                                            <Grid ColumnDefinitions="120,16,*,Auto">
                                                <Image Grid.Column="0"
                                                       Source="{Binding SourcePath, Converter={StaticResource StringToUri}}"
                                                       Width="120"
                                                       Height="90"
                                                       Stretch="UniformToFill" />
                                                <StackPanel Grid.Column="2"
                                                            Spacing="8"
                                                            VerticalAlignment="Center">
                                                    <TextBox Classes="form-input"
                                                             Text="{Binding Nickname}"
                                                             PlaceholderText="Nom affiché de l'image" />
                                                    <TextBlock Text="{Binding SelectedFileName}"
                                                               Classes="form-hint"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="3"
                                                        Content="Retirer"
                                                        Command="{Binding RemoveCommand}"
                                                        Classes="form-cancel"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="form-section">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="section-title" Text="Patron" />
                            <Grid ColumnDefinitions="*,16,220">
                                <StackPanel Grid.Column="0" Classes="form-field">
                                    <TextBlock Classes="form-label" Text="Rechercher un patron" />
                                    <TextBox Classes="form-input"
                                             Text="{Binding PatternSearchQuery}"
                                             PlaceholderText="Nom, type, url ou note du patron..." />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Classes="form-field">
                                    <TextBlock Classes="form-label" Text="Type de patron" />
                                    <ComboBox ItemsSource="{Binding PatternTypeFilters}"
                                              SelectedItem="{Binding SelectedPatternTypeFilter, Mode=TwoWay}"
                                              Classes="form-select"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="projects:ProjectPatternTypeFilterViewModel">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="6" IsVisible="{Binding HasSelectedPattern}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Classes="form-label"
                                               Text="Patron sélectionné" />
                                    <Button Grid.Column="1"
                                            Content="Retirer"
                                            Command="{Binding ClearPatternCommand}"
                                            Classes="form-cancel"
                                            Padding="10 4" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding SelectedPatterns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="projects:ProjectSelectablePatternViewModel">
                                            <Border Padding="12 10"
                                                    Background="{StaticResource BackgroundHoverBrush}"
                                                    BorderBrush="{StaticResource PrimaryDarkBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Grid ColumnDefinitions="*,130,130,110,110" ColumnSpacing="14">
                                                    <TextBlock Text="{Binding Pattern.Name}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding TypeDisplay}"
                                                               FontSize="13"
                                                               Opacity="0.8"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding OriginDisplay}"
                                                               FontSize="13"
                                                               Opacity="0.8"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding BeginDateDisplay}"
                                                               FontSize="13"
                                                               Opacity="0.7"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding EndDateDisplay}"
                                                               FontSize="13"
                                                               Opacity="0.7"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="0">
                                <Border Padding="12 10"
                                        Background="{StaticResource BackgroundCardBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8 8 0 0">
                                    <Grid ColumnDefinitions="*,130,130,110,110" ColumnSpacing="14">
                                        <TextBlock Text="Nom" FontSize="12" FontWeight="SemiBold" Opacity="0.55" />
                                        <TextBlock Grid.Column="1" Text="Type" FontSize="12" FontWeight="SemiBold"
                                                   Opacity="0.55" />
                                        <TextBlock Grid.Column="2" Text="Origine" FontSize="12" FontWeight="SemiBold"
                                                   Opacity="0.55" />
                                        <TextBlock Grid.Column="3" Text="Début" FontSize="12" FontWeight="SemiBold"
                                                   Opacity="0.55" />
                                        <TextBlock Grid.Column="4" Text="Fin" FontSize="12" FontWeight="SemiBold"
                                                   Opacity="0.55" />
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding PatternResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="projects:ProjectSelectablePatternViewModel">
                                            <Button Command="{Binding SelectCommand}"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch">
                                                <Border Padding="12 10"
                                                        Background="{StaticResource BackgroundCardBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1 0 1 1">
                                                    <Border.Styles>
                                                        <Style Selector="Border:pointerover">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource BackgroundHoverBrush}" />
                                                        </Style>
                                                    </Border.Styles>
                                                    <Grid ColumnDefinitions="*,130,130,110,110" ColumnSpacing="14">
                                                        <TextBlock Text="{Binding Pattern.Name}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding TypeDisplay}"
                                                                   FontSize="13"
                                                                   Opacity="0.8"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding OriginDisplay}"
                                                                   FontSize="13"
                                                                   Opacity="0.8"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding BeginDateDisplay}"
                                                                   FontSize="13"
                                                                   Opacity="0.7"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding EndDateDisplay}"
                                                                   FontSize="13"
                                                                   Opacity="0.7"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="form-section">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="section-title" Text="Laines" />
                            <StackPanel Classes="form-field">
                                <TextBlock Classes="form-label" Text="Recherche intelligente" />
                                <TextBox Classes="form-input"
                                         Text="{Binding WoolSearchQuery}"
                                         PlaceholderText="Ex : drops rouge coton..." />
                            </StackPanel>

                            <StackPanel Spacing="6" IsVisible="{Binding HasSelectedWools}">
                                <TextBlock Classes="form-label" Text="Laines sélectionnées" />
                                <ItemsControl ItemsSource="{Binding SelectedWools}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="projects:ProjectSelectableWoolViewModel">
                                            <Button Command="{Binding ToggleCommand}"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch">
                                                <Border Padding="12 10"
                                                        Background="{StaticResource BackgroundHoverBrush}"
                                                        BorderBrush="{StaticResource PrimaryDarkBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8">
                                                    <Grid ColumnDefinitions="28,*,130,130,110" ColumnSpacing="14">
                                                        <userControls:ColorPieControl
                                                            Grid.Column="0"
                                                            Colors="{Binding Wool.Colors}"
                                                            Width="16" Height="16"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Wool.Name}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Wool.Brand}"
                                                                   FontSize="13"
                                                                   Opacity="0.8"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding Wool.Material}"
                                                                   FontSize="13"
                                                                   Opacity="0.8"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding StockDisplay}"
                                                                   FontSize="13"
                                                                   Opacity="0.7"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="0">
                                <Border Padding="12 10"
                                        Background="{StaticResource BackgroundCardBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8 8 0 0">
                                    <Grid ColumnDefinitions="28,*,130,130,110" ColumnSpacing="14">
                                        <TextBlock Text="" />
                                        <TextBlock Grid.Column="1" Text="Nom" FontSize="12" FontWeight="SemiBold"
                                                   Opacity="0.55" />
                                        <TextBlock Grid.Column="2" Text="Marque" FontSize="12" FontWeight="SemiBold"
                                                   Opacity="0.55" />
                                        <TextBlock Grid.Column="3" Text="Matière" FontSize="12" FontWeight="SemiBold"
                                                   Opacity="0.55" />
                                        <TextBlock Grid.Column="4" Text="Stock" FontSize="12" FontWeight="SemiBold"
                                                   Opacity="0.55" />
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding WoolResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="projects:ProjectSelectableWoolViewModel">
                                            <Button Command="{Binding ToggleCommand}"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch">
                                                <Border Padding="12 10"
                                                        Background="{StaticResource BackgroundCardBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1 0 1 1">
                                                    <Border.Styles>
                                                        <Style Selector="Border:pointerover">
                                                            <Setter Property="Background"
                                                                    Value="{StaticResource BackgroundHoverBrush}" />
                                                        </Style>
                                                    </Border.Styles>
                                                    <Grid ColumnDefinitions="28,*,130,130,110" ColumnSpacing="14">
                                                        <userControls:ColorPieControl
                                                            Grid.Column="0"
                                                            Colors="{Binding Wool.Colors}"
                                                            Width="20" Height="20"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Wool.Name}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Wool.Brand}"
                                                                   FontSize="13"
                                                                   Opacity="0.8"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding Wool.Material}"
                                                                   FontSize="13"
                                                                   Opacity="0.8"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding StockDisplay}"
                                                                   FontSize="13"
                                                                   Opacity="0.7"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="alert-error"
                            Padding="12"
                            IsVisible="{Binding HasError}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="#991B1B" />
                    </Border>

                    <StackPanel Classes="form-actions">
                        <Button Classes="form-cancel"
                                Content="Annuler"
                                Command="{Binding CancelCommand}" />
                        <Button Classes="form-submit"
                                Content="{Binding Title}"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>