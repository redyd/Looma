<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Looma.Views.Markup"
             xmlns:vm="using:Looma.Presentation.ViewModels.Sections.Projects"
             xmlns:controls="clr-namespace:Looma.Views.UserControls"
             xmlns:pcontrols="clr-namespace:Looma.Presentation.UserControls;assembly=Looma.Presentation"
             xmlns:projects="clr-namespace:Looma.Presentation.ViewModels.Shared.Projects;assembly=Looma.Presentation"
             x:Class="Looma.Views.Views.Sections.Projects.ProjectsDetailView"
             x:DataType="vm:ProjectsDetailViewModel">

    <DockPanel>

        <controls:DetailHeader
            DockPanel.Dock="Top"
            GoBackCommand="{Binding GoBackCommand}"
            EditCommand="{Binding EditCommand}"
            DeleteCommand="{Binding ConfirmDeleteCommand}">

            <controls:DetailHeader.TitleContent>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Display.Name}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DetailTitleForegroundBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Display.StatusDisplay}"
                               FontSize="14"
                               Opacity="0.5"
                               Foreground="{DynamicResource DetailSubtitleForegroundBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </controls:DetailHeader.TitleContent>

        </controls:DetailHeader>

        <ScrollViewer>
            <StackPanel Margin="32" Spacing="16">

                <Button Classes="card-button"
                        Command="{Binding OpenPatternCommand}"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                    <Border Classes="form-section"
                            Padding="16">
                        <Grid ColumnDefinitions="*,120,120,140,100" ColumnSpacing="18">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="{Binding Display.PatternName}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PatternPreviewPrimaryForegroundBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Display.PatternNoteDisplay}"
                                           FontSize="12"
                                           Opacity="0.65"
                                           Foreground="{DynamicResource PatternPreviewSecondaryForegroundBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Display.PatternTypeDisplay}"
                                       FontSize="13"
                                       Opacity="0.8"
                                       Foreground="{DynamicResource PatternPreviewMetadataForegroundBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Display.Pattern.Documents.Count, StringFormat='Documents: {0}'}"
                                       FontSize="13"
                                       Opacity="0.7"
                                       Foreground="{DynamicResource PatternPreviewMetadataForegroundBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Display.Pattern.Url}"
                                       FontSize="13"
                                       Opacity="0.65"
                                       Foreground="{DynamicResource PatternPreviewMetadataForegroundBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4"
                                       Text="{Binding Display.PatternActionText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Opacity="0.7"
                                       Foreground="{DynamicResource PatternPreviewPrimaryForegroundBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Button>

                <Grid ColumnDefinitions="2.1*,16,0.9*">
                    <Border Grid.Column="0"
                            Classes="form-section"
                            Padding="16"
                            MinHeight="260"
                            IsVisible="{Binding Display.HasImages}">
                        <Grid RowDefinitions="*,12,Auto">
                            <Image Grid.Row="0"
                                   Source="{Binding Display.SelectedImage.SourcePath, Converter={StaticResource StringToUri}}"
                                   MaxHeight="340"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                            <Grid Grid.Row="2"
                                  ColumnDefinitions="Auto,*,Auto"
                                  IsVisible="{Binding Display.HasMultipleImages}">
                                <Button Grid.Column="0"
                                        Content="{loc:Loc Common_Previous}"
                                        Command="{Binding PreviousImageCommand}"
                                        Classes="cancel-btn" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Display.ImagePositionDisplay}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Opacity="0.65" />
                                <Button Grid.Column="2"
                                        Content="{loc:Loc Common_Next}"
                                        Command="{Binding NextImageCommand}"
                                        Classes="form-submit" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="0"
                            Classes="form-section"
                            IsVisible="{Binding !Display.HasImages}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="section-title" Text="{loc:Loc Common_Images}" />
                            <TextBlock Text="{loc:Loc ProjectsDetail_NoProjectImage}"
                                       Classes="form-hint" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Classes="form-section">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0 0 0 14">
                                <LucideIcon Kind="BadgeInfo"
                                            Size="18"
                                            Foreground="{DynamicResource DetailLinkForegroundBrush}"
                                            VerticalAlignment="Center" />
                                <TextBlock Classes="section-title"
                                           Text="{loc:Loc Common_Information}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Display.ProjectInfos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="pcontrols:InfoItem">
                                        <Grid ColumnDefinitions="92,*">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Label}"
                                                       FontSize="13"
                                                       Opacity="0.5"
                                                       Foreground="{DynamicResource DetailFieldLabelForegroundBrush}"
                                                       Margin="0 0 0 10" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Value}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource DetailFieldValueForegroundBrush}"
                                                       Margin="0 0 0 10"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,16,*">

                    <Border Grid.Column="0" Classes="form-section">
                        <Grid RowDefinitions="Auto,12,*,12,Auto">
                            <TextBlock Grid.Row="0"
                                       Classes="section-title"
                                       Text="{loc:Loc Common_Note}" />
                            <TextBox Classes="form-input"
                                     Grid.Row="2"
                                     Text="{Binding Display.Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="{loc:Loc Common_NoNote}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="NaN"
                                     MinHeight="150"
                                     Padding="12 10"
                                     VerticalAlignment="Stretch"
                                     VerticalContentAlignment="Top" />
                            <Button Content="{loc:Loc Common_EditNote}"
                                    Grid.Row="4"
                                    Command="{Binding SaveNoteCommand}"
                                    Classes="form-submit"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Classes="form-section">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="section-title" Text="{loc:Loc ProjectsDetail_ProjectWools}" />
                            <Grid ColumnDefinitions="*,12,200" IsVisible="{Binding Display.HasWools}">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Classes="form-label" Text="{loc:Loc Common_Quantity}" />
                                    <TextBox Classes="form-input"
                                             Text="{Binding WoolAdjustmentQuantityText, Mode=TwoWay}"
                                             PlaceholderText="{loc:Loc ProjectsDetail_QuantityPlaceholder}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Classes="form-label" Text="{loc:Loc Common_Mode}" />
                                    <ComboBox ItemsSource="{Binding WoolAdjustmentModes}"
                                              SelectedItem="{Binding WoolAdjustmentMode}"
                                              Classes="form-select"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplayName}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="{loc:Loc ProjectsDetail_DeductImmediately}"
                                      IsChecked="{Binding DeductWoolImmediately}"
                                      IsVisible="{Binding Display.HasWools}" />
                            <TextBlock Text="{loc:Loc ProjectsDetail_NoSelectedWool}"
                                       Classes="form-hint"
                                       IsVisible="{Binding !Display.HasWools}" />
                            <StackPanel Spacing="6" IsVisible="{Binding Display.HasWools}">
                                <TextBlock Classes="form-label" Text="{loc:Loc Common_Display}" />
                                <ComboBox ItemsSource="{Binding WoolDisplayModes}"
                                          SelectedItem="{Binding WoolDisplayMode}"
                                          Classes="form-select"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDisplayName}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Display.Wools}"
                                          IsVisible="{Binding Display.HasWools}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="projects:ProjectWoolUsageViewModel">
                                        <Border Classes="surface-panel" Padding="12">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                                <controls:ColorPieControl
                                                    Grid.Column="0"
                                                    Colors="{Binding Colors}"
                                                    Width="16" Height="16"
                                                    VerticalAlignment="Top"
                                                    Margin="0 4 0 0"/>
                                                <StackPanel Grid.Column="1" Spacing="5">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ProjectWoolPrimaryForegroundBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Brand}"
                                                               Classes="form-hint"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding AvailableSummary}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource ProjectWoolMetadataForegroundBrush}"
                                                               Opacity="0.75" />
                                                    <TextBlock Text="{Binding UsedSummary}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource ProjectWoolMetadataForegroundBrush}"
                                                               Opacity="0.75" />
                                                    <TextBlock Text="{Binding AlreadyDeductedSummary}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource ProjectWoolMetadataForegroundBrush}"
                                                               Opacity="0.75" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <Button Content="{loc:Loc Common_Use}"
                                                            Command="{Binding AddCommand}"
                                                            Classes="form-submit"
                                                            MinWidth="90"
                                                            Height="36"
                                                            Padding="10 0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </Grid>

                <Grid ColumnDefinitions="*,12,*"
                      IsVisible="{Binding Display.HasProjectActions}">
                    <Button Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Content="{loc:Loc ProjectsDetail_StartProject}"
                            Command="{Binding StartProjectCommand}"
                            Classes="form-submit"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            IsVisible="{Binding Display.IsWishlist}" />
                    <Button Grid.Column="0"
                            Content="{loc:Loc ProjectsDetail_PauseProject}"
                            Command="{Binding PauseProjectCommand}"
                            Classes="cancel-btn"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            IsVisible="{Binding Display.IsInProgress}" />
                    <Button Grid.Column="2"
                            Content="{loc:Loc ProjectsDetail_FinishProject}"
                            Command="{Binding FinishProjectCommand}"
                            Classes="form-submit"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            IsVisible="{Binding Display.IsInProgress}" />
                    <Button Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Content="{loc:Loc ProjectsDetail_Resume}"
                            Command="{Binding ResumeProjectCommand}"
                            Classes="form-submit"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            IsVisible="{Binding Display.IsPaused}" />
                </Grid>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
