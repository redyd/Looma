<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Looma.Presentation.ViewModels.Sections.Projects"
             xmlns:controls="clr-namespace:Looma.Views.UserControls"
             xmlns:pcontrols="clr-namespace:Looma.Presentation.UserControls;assembly=Looma.Presentation"
             x:Class="Looma.Views.Views.Sections.Projects.ProjectsDetailView"
             x:DataType="vm:ProjectsDetailViewModel">

    <DockPanel>

        <controls:DetailHeader
            DockPanel.Dock="Top"
            GoBackCommand="{Binding GoBackCommand}"
            EditCommand="{Binding EditCommand}"
            DeleteCommand="{Binding ConfirmDeleteCommand}">

            <controls:DetailHeader.TitleContent>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding StatusDisplay}"
                               FontSize="14"
                               Opacity="0.5"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </controls:DetailHeader.TitleContent>

        </controls:DetailHeader>

        <ScrollViewer>
            <StackPanel Margin="32" Spacing="16">

                <Button Classes="card-button"
                        Command="{Binding OpenPatternCommand}"
                        HorizontalAlignment="Stretch">
                    <Border Classes="form-section"
                            Padding="16">
                        <Grid ColumnDefinitions="*,120,140,100" ColumnSpacing="18">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Text="{Binding PatternName}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding PatternNoteDisplay}"
                                           FontSize="12"
                                           Opacity="0.65"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding PatternTypeDisplay}"
                                       FontSize="13"
                                       Opacity="0.8"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Pattern.Url}"
                                       FontSize="13"
                                       Opacity="0.65"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3"
                                       Text="Ouvrir"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Opacity="0.7"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Button>

                <Grid ColumnDefinitions="*,16,*">

                    <StackPanel Grid.Column="0" Spacing="16">
                        <Border Classes="form-section">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="section-title" Text="Informations" />
                                <ItemsControl ItemsSource="{Binding ProjectInfos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="pcontrols:InfoItem">
                                            <Grid ColumnDefinitions="110,*">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           FontSize="13"
                                                           Opacity="0.5"
                                                           Margin="0 0 0 10" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Value}"
                                                           FontSize="14"
                                                           Margin="0 0 0 10"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Classes="form-section">
                            <StackPanel Spacing="12">
                                <TextBlock Classes="section-title" Text="Note" />
                                <TextBlock Text="{Binding NoteDisplay}"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           LineHeight="20" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="2" Classes="form-section">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="section-title" Text="Laines du projet" />
                            <TextBlock Text="Aucune laine sélectionnée"
                                       Classes="form-hint"
                                       IsVisible="{Binding !HasWools}" />
                            <ItemsControl ItemsSource="{Binding Wools}"
                                          IsVisible="{Binding HasWools}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProjectWoolUsageViewModel">
                                        <Border Classes="surface-panel" Padding="12">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Ellipse Grid.Column="0"
                                                         Width="14"
                                                         Height="14"
                                                         Fill="{Binding Color, Converter={StaticResource HexToColor}}"
                                                         VerticalAlignment="Top"
                                                         Margin="0 4 0 0" />
                                                <StackPanel Grid.Column="1" Spacing="5">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Brand}"
                                                               Classes="form-hint"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Grid ColumnDefinitions="*,*">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding AvailableDisplay, StringFormat='Disponible: {0}'}"
                                                                   FontSize="12"
                                                                   Opacity="0.75" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding UsedDisplay, StringFormat='Utilisé: {0}'}"
                                                                   FontSize="12"
                                                                   Opacity="0.75" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <Button Content="-"
                                                            Command="{Binding RemoveCommand}"
                                                            Classes="form-cancel"
                                                            Width="36"
                                                            MinWidth="36"
                                                            Height="36"
                                                            Padding="0" />
                                                    <Button Content="+"
                                                            Command="{Binding AddCommand}"
                                                            Classes="form-submit"
                                                            Width="36"
                                                            MinWidth="36"
                                                            Height="36"
                                                            Padding="0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </Grid>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
