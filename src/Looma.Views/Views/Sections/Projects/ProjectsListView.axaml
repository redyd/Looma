<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Looma.Presentation.ViewModels.Sections.Projects"
             xmlns:userControls="clr-namespace:Looma.Views.UserControls"
             xmlns:projects="clr-namespace:Looma.Presentation.ViewModels.Shared.Projects;assembly=Looma.Presentation"
             x:Class="Looma.Views.Views.Sections.Projects.ProjectsListView"
             x:DataType="vm:ProjectsListViewModel">

    <DockPanel Margin="32">

        <Grid DockPanel.Dock="Top" Margin="0 0 0 24" ColumnDefinitions="2*,16,*">
            <TextBox Grid.Column="0"
                     Classes="form-input"
                     Text="{Binding SearchQuery}"
                     PlaceholderText="{Binding Translation[Projects_SearchPlaceholder]}"
                     VerticalContentAlignment="Center" />

            <ComboBox Grid.Column="2"
                      Classes="form-select"
                      ItemsSource="{Binding StatusFilters}"
                      SelectedItem="{Binding SelectedStatusFilter}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="projects:ProjectStatusFilterViewModel">
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <DockPanel DockPanel.Dock="Top"
                   Margin="0 0 0 20"
                   HorizontalSpacing="20">
            <TextBlock Text="{Binding Translation[Projects_Title]}"
                       Classes="page-title"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right"
                    Command="{Binding OpenAddFormCommand}"
                    Classes="form-submit">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <LucideIcon Kind="Grid2x2Plus"
                                Size="16"
                                Foreground="{DynamicResource SubmitButtonIconForegroundBrush}"
                                VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Translation[Projects_AddProject]}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>

        <userControls:PaginationControl
            DockPanel.Dock="Bottom"
            IsVisible="{Binding !IsListEmpty}"
            PreviousPageCommand="{Binding PreviousPageCommand}"
            NextPageCommand="{Binding NextPageCommand}"
            HasPreviousPage="{Binding HasPreviousPage}"
            HasNextPage="{Binding HasNextPage}"
            PageInfo="{Binding PageInfo}" />

        <Grid>
            <Border IsVisible="{Binding IsSourceListEmpty}"
                    Classes="empty-state">
                <StackPanel Spacing="8"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Translation[Projects_NoProjectsAtThisTime]}"
                               Classes="empty-state-title" />

                    <TextBlock Text="{Binding Translation[Projects_CreateFirstProject]}"
                               Classes="empty-state-message" />
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding IsFilterResultEmpty}"
                    Classes="empty-state">
                <StackPanel Spacing="8"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Translation[Projects_NoProjectsFound]}"
                               Classes="empty-state-title" />

                    <TextBlock Text="{Binding Translation[Projects_TryEditSearchCriteria]}"
                               Classes="empty-state-message" />
                </StackPanel>
            </Border>

            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding CurrentPageEntities}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="projects:ProjectSummaryViewModel">
                            <Button Classes="card-button"
                                    Command="{Binding OpenDetailCommand}"
                                    HorizontalAlignment="Left">
                                <Border Width="260"
                                        Height="176"
                                        Margin="8"
                                        Padding="0"
                                        Classes="surface-card interactive-card">
                                    <Grid RowDefinitions="Auto,*">
                                        <Border Grid.Row="0"
                                                Classes="project-status-ribbon"
                                                Classes.status-wishlist="{Binding Project.Status, Converter={StaticResource EnumToBool}, ConverterParameter=Wishlist}"
                                                Classes.status-in-progress="{Binding Project.Status, Converter={StaticResource EnumToBool}, ConverterParameter=InProgress}"
                                                Classes.status-finished="{Binding Project.Status, Converter={StaticResource EnumToBool}, ConverterParameter=Finished}"
                                                Classes.status-paused="{Binding Project.Status, Converter={StaticResource EnumToBool}, ConverterParameter=Paused}">
                                            <TextBlock Text="{Binding StatusDisplay}"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       Margin="16 0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource RibbonForegroundBrush}" />
                                        </Border>

                                        <Grid Grid.Row="1"
                                              Margin="16"
                                              RowDefinitions="Auto,*,Auto">
                                            <StackPanel Grid.Row="0" Spacing="4">
                                                <TextBlock Text="{Binding Project.Name}"
                                                           Classes="card-title"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding PatternName}"
                                                           Classes="card-subtitle"
                                                           FontSize="12"
                                                           Opacity="0.65"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        VerticalAlignment="Center">
                                                <Border Classes="surface-chip"
                                                        Padding="8 3"
                                                        IsVisible="{Binding HasPatternType}">
                                                    <TextBlock Text="{Binding PatternTypeDisplay}"
                                                               Classes="card-meta"
                                                               FontSize="11" />
                                                </Border>
                                                <Border Classes="surface-chip" Padding="8 3">
                                                    <TextBlock Text="{Binding WoolCountDisplay}"
                                                               Classes="card-meta"
                                                               FontSize="11" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Spacing="2">
                                                <TextBlock Text="{Binding BeginDateDisplay, StringFormat='Début: {0}'}"
                                                           Classes="card-meta"
                                                           IsVisible="{Binding HasBeginDate}"
                                                           FontSize="11"
                                                           Opacity="0.65" />
                                                <TextBlock Text="{Binding EndDateDisplay, StringFormat='Fin: {0}'}"
                                                           Classes="card-meta"
                                                           IsVisible="{Binding HasEndDate}"
                                                           FontSize="11"
                                                           Opacity="0.65" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

    </DockPanel>
</UserControl>
