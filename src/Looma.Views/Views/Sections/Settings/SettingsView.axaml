<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Looma.Presentation.ViewModels.Sections.Settings"
             x:Class="Looma.Views.Views.Sections.Settings.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <DockPanel Margin="32">
        <DockPanel DockPanel.Dock="Top"
                   Margin="0 0 0 24"
                   HorizontalSpacing="20">
            <TextBlock Text="Paramètres"
                       Classes="page-title"
                       VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer>
            <StackPanel Spacing="20">
                <Border Classes="form-container">
                    <StackPanel Spacing="18">
                        <DockPanel HorizontalSpacing="12">
                            <TextBlock Text="Thème"
                                       Classes="section-title"
                                       VerticalAlignment="Center" />

                            <Button DockPanel.Dock="Right"
                                    Classes="pagination-btn"
                                    Command="{Binding RefreshThemesCommand}"
                                    ToolTip.Tip="Rafraîchir les thèmes">
                                <LucideIcon Kind="RefreshCw" Size="18" />
                            </Button>
                        </DockPanel>

                        <Grid ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="12">
                            <ComboBox Grid.Column="0"
                                      Classes="form-select"
                                      ItemsSource="{Binding Themes}"
                                      SelectedItem="{Binding SelectedTheme}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ThemeOptionViewModel">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Grid.Column="1"
                                    Classes="cancel-btn"
                                    Command="{Binding ImportThemeCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <LucideIcon Kind="Upload" Size="16" VerticalAlignment="Center" />
                                    <TextBlock Text="Importer" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    Classes="form-submit"
                                    Command="{Binding ExportThemeCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <LucideIcon Kind="Download"
                                                Size="16"
                                                Foreground="{DynamicResource SubmitButtonIconForegroundBrush}"
                                                VerticalAlignment="Center" />
                                    <TextBlock Text="Exporter" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
