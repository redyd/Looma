<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Looma.Presentation.ViewModels.Shared.Settings"
             xmlns:vm="using:Looma.Presentation.ViewModels.Sections.Settings"
             x:Class="Looma.Views.Views.Sections.Settings.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid Margin="32">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top"
                       Margin="0 0 0 24"
                       HorizontalSpacing="20">
                <TextBlock Text="Paramètres"
                           Classes="page-title"
                           VerticalAlignment="Center" />
            </DockPanel>

            <ScrollViewer Margin="0 0 0 44">
                <StackPanel Spacing="20">
                    <Border Classes="form-container">
                        <StackPanel Spacing="18">
                            <TextBlock Text="Langue"
                                       Classes="section-title"
                                       VerticalAlignment="Center" />

                            <ComboBox Classes="form-select"
                                      ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding SelectedLanguage}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LanguageOptionViewModel">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Classes="form-container">
                        <StackPanel Spacing="18">
                            <DockPanel HorizontalSpacing="12">
                                <TextBlock Text="Thème"
                                           Classes="section-title"
                                           VerticalAlignment="Center" />

                                <Button DockPanel.Dock="Right"
                                        Classes="pagination-btn"
                                        Command="{Binding RefreshThemesCommand}"
                                        ToolTip.Tip="Rafraîchir les thèmes">
                                    <LucideIcon Kind="RefreshCw" Size="18" />
                                </Button>
                            </DockPanel>

                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="12">
                                <ComboBox Grid.Column="0"
                                          Classes="form-select"
                                          ItemsSource="{Binding Themes}"
                                          SelectedItem="{Binding SelectedTheme}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="settings:ThemeOptionViewModel">
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Button Grid.Column="1"
                                        Classes="cancel-btn"
                                        Command="{Binding OpenSelectedThemeCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <LucideIcon Kind="ExternalLink"
                                                    Size="16"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                    VerticalAlignment="Center" />
                                        <TextBlock Text="Ouvrir" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Classes="danger-btn"
                                        Command="{Binding DeleteSelectedThemeCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <LucideIcon Kind="Trash2"
                                                    Size="16"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                    VerticalAlignment="Center" />
                                        <TextBlock Text="Supprimer" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="3"
                                        Classes="cancel-btn"
                                        Command="{Binding ImportThemeCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <LucideIcon Kind="Upload"
                                                    Size="16"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                    VerticalAlignment="Center" />
                                        <TextBlock Text="Importer" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="4"
                                        Classes="form-submit"
                                        Command="{Binding ExportThemeCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <LucideIcon Kind="Download"
                                                    Size="16"
                                                    Foreground="{DynamicResource SubmitButtonIconForegroundBrush}"
                                                    VerticalAlignment="Center" />
                                        <TextBlock Text="Exporter" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Classes="surface-chip"
                Padding="10 6">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding Updater.InstalledVersion}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button Classes="pagination-btn"
                        Width="28"
                        Height="28"
                        MinWidth="28"
                        Command="{Binding Updater.ShowCurrentReleaseNotesCommand}"
                        ToolTip.Tip="Notes de version">
                    <LucideIcon Kind="FileText" Size="15" />
                </Button>
                <Button Classes="pagination-btn no-disable-style"
                        Width="28" Height="28" MinWidth="28"
                        Command="{Binding Updater.CheckForUpdatesCommand}"
                        ToolTip.Tip="{Binding Updater.UpdateToolTip}">
                    <Panel Width="15" Height="15"
                           RenderTransformOrigin="50%,50%"
                           Classes.spinning="{Binding Updater.IsCheckingForUpdates}">
                        <Panel.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Panel.RenderTransform>
                        <Panel.Styles>
                            <Style Selector="Panel.spinning">
                                <Style.Animations>
                                    <Animation Duration="0:0:1"
                                               IterationCount="INFINITE"
                                               Easing="LinearEasing">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="RotateTransform.Angle" Value="0" />
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="RotateTransform.Angle" Value="360" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Panel.Styles>
                        <LucideIcon Kind="{Binding Updater.UpdateIconKind}" Size="15" />
                    </Panel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
