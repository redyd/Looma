<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Looma.Views.Markup"
    xmlns:vm="using:Looma.Presentation.ViewModels.Sections.Documents"
    xmlns:shared="using:Looma.Presentation.ViewModels.Shared"
    xmlns:userControls="clr-namespace:Looma.Views.UserControls"
    x:Class="Looma.Views.Views.Sections.Documents.DocumentsListView"
    x:DataType="vm:DocumentsListViewModel"
>

    <DockPanel Margin="32">

        <Grid DockPanel.Dock="Top" Margin="0 0 0 24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="1"
                Classes="form-input"
                Text="{Binding SearchQuery}"
                PlaceholderText="{loc:Loc Documents_SearchPlaceholder}"
                VerticalContentAlignment="Center"
            />
        </Grid>

        <DockPanel
            DockPanel.Dock="Top"
            Margin="0 0 0 20"
            HorizontalSpacing="20"
        >
            <TextBlock
                Text="{loc:Loc Documents_Title}"
                Classes="page-title"
                VerticalAlignment="Center"
            />
        </DockPanel>

        <userControls:PaginationControl
            DockPanel.Dock="Bottom"
            IsVisible="{Binding !IsListEmpty}"
            PreviousPageCommand="{Binding PreviousPageCommand}"
            NextPageCommand="{Binding NextPageCommand}"
            HasPreviousPage="{Binding HasPreviousPage}"
            HasNextPage="{Binding HasNextPage}"
            PageInfo="{Binding PageInfo}" />

        <ScrollViewer>
            <StackPanel Spacing="0">
                <Border
                    Classes="table-header"
                >
                    <Grid
                        ColumnDefinitions="1.6*,70,80,100,420"
                        ColumnSpacing="14"
                    >
                        <TextBlock
                            Text="{loc:Loc Common_Name}"
                            Classes="table-heading"
                        />
                        <TextBlock
                            Grid.Column="1"
                            Text="{loc:Loc Common_Type}"
                            Classes="table-heading"
                        />
                        <TextBlock
                            Grid.Column="2"
                            Text="{loc:Loc Common_Size}"
                            Classes="table-heading"
                        />
                        <TextBlock
                            Grid.Column="3"
                            Text="{loc:Loc Common_Origin}"
                            Classes="table-heading"
                        />
                        <TextBlock
                            Grid.Column="4"
                            Text="{loc:Loc Common_Actions}"
                            Classes="table-heading"
                            HorizontalAlignment="Left"
                        />
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding CurrentPageEntities}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="0" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="shared:DocumentSummaryViewModel">
                            <Border
                                Classes="table-row"
                            >
                                <Grid
                                    ColumnDefinitions="1.6*,70,80,100,420"
                                    ColumnSpacing="14"
                                >
                                    <StackPanel
                                        Spacing="4"
                                        VerticalAlignment="Center"
                                    >
                                        <TextBlock
                                            Text="{Binding Document.Nickname}"
                                            Classes="card-title"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis"
                                        />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding TypeDisplay}"
                                        Foreground="{DynamicResource CardMetadataForegroundBrush}"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Opacity="0.8"
                                        TextAlignment="Left"
                                    />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding SizeDisplay}"
                                        Foreground="{DynamicResource CardMetadataForegroundBrush}"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Opacity="0.7"
                                        TextAlignment="Left"
                                    />
                                    <StackPanel
                                        Grid.Column="3"
                                        Spacing="3"
                                        VerticalAlignment="Center"
                                    >
                                        <TextBlock
                                            Text="{Binding OriginTypeDisplay}"
                                            Foreground="{DynamicResource CardMetadataForegroundBrush}"
                                            FontSize="12"
                                            Opacity="0.55"
                                            IsVisible="{Binding HasOrigin}"
                                        />
                                        <TextBlock
                                            Text="{loc:Loc Documents_FreeDocument}"
                                            Classes="form-hint"
                                            IsVisible="{Binding !HasOrigin}"
                                        />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="4"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                    >
                                        <Button
                                            Content="{loc:Loc Common_Open}"
                                            Command="{Binding OpenCommand}"
                                            Classes="cancel-btn"
                                            MinWidth="80"
                                        />
                                        <Button
                                            Content="{loc:Loc Common_View}"
                                            Command="{Binding OpenOriginCommand}"
                                            Classes="cancel-btn"
                                            MinWidth="80"
                                            IsVisible="{Binding HasOrigin}"
                                        />
                                        <Button
                                            Content="{loc:Loc Common_Edit}"
                                            Command="{Binding EditCommand}"
                                            Classes="cancel-btn"
                                            MinWidth="80"
                                        />
                                        <Panel>
                                            <Button
                                                x:Name="DeleteButton"
                                                Content="{loc:Loc Common_Delete}"
                                                Click="OnDeleteClicked"
                                                Tag="{Binding #DeletePopup}"
                                                Classes="danger-btn"
                                                MinWidth="96"
                                            />

                                            <Popup
                                                x:Name="DeletePopup"
                                                PlacementTarget="{Binding #DeleteButton}"
                                                Placement="BottomEdgeAlignedLeft"
                                                HorizontalOffset="-180"
                                            >
                                                <Border Classes="form-container" Padding="16" Width="280">
                                                    <StackPanel Spacing="12">
                                                        <TextBlock Text="{loc:Loc Common_DeleteQuestion}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource FormLabelForegroundBrush}" />
                                                        <TextBlock Text="{loc:Loc Common_PermanentAction}" Classes="form-hint" />
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    Spacing="8">
                                                            <Button Content="{loc:Loc Common_Cancel}"
                                                                    Click="OnCancelDeleteClicked"
                                                                    Tag="{Binding #DeletePopup}"
                                                                    Classes="cancel-btn" />
                                                            <Button Content="{loc:Loc Common_Delete}"
                                                                    Click="OnConfirmDeleteClicked"
                                                                    Tag="{Binding #DeletePopup}"
                                                                    Command="{Binding DeleteCommand}"
                                                                    Classes="danger-btn" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Panel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border
                    Classes="table-empty-row"
                    IsVisible="{Binding IsListEmpty}"
                >
                    <TextBlock
                        Text="{loc:Loc Documents_NoDocumentToDisplay}"
                        Classes="form-hint"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                    />
                </Border>
            </StackPanel>
        </ScrollViewer>
</DockPanel>
</UserControl>
