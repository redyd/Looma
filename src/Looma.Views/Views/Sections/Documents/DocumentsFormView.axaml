<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Looma.Presentation.ViewModels.Sections.Documents"
             x:Class="Looma.Views.Views.Sections.Documents.DocumentsFormView"
             x:DataType="vm:DocumentsFormViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center"
                    Margin="32"
                    Width="780"
                    MinWidth="780">

            <Border Classes="form-container" Width="780" MinWidth="780">
                <StackPanel Spacing="0">

                    <StackPanel Classes="form-header">
                        <TextBlock Classes="form-title" Text="{Binding Title}" />
                        <TextBlock Classes="form-subtitle"
                                   Text="Ajoutez un fichier dans le dossier de l'application ou renommez son affichage." />
                    </StackPanel>

                    <Border Classes="form-section">
                        <StackPanel Spacing="0">
                            <TextBlock Classes="section-title"
                                       Text="Informations"
                                       Margin="0 0 0 16" />

                            <StackPanel Classes="form-field">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Classes="form-label" Text="Nommer le document" />
                                    <TextBlock Classes="form-label" Opacity="0.5" Text="(optionnel à la création)" />
                                </StackPanel>
                                <TextBox Classes="form-input"
                                         Text="{Binding Nickname}"
                                         PlaceholderText="Nom affiché du document" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Classes="form-actions">
                        <Button Classes="cancel-btn"
                                Content="Annuler"
                                Command="{Binding CancelCommand}" />
                        <Button Classes="form-submit"
                                Content="{Binding Title}"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
