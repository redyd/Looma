<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="avares://Looma.App/Assets/icon.ico"
        xmlns:controls="using:Looma.Views.UserControls"
        xmlns:notifications="using:Looma.Presentation.Notifications"
        xmlns:vm="using:Looma.Presentation.ViewModels.Main"
        x:Class="Looma.Views.Views.Main.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Looma" Width="1024" Height="768"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Background="{DynamicResource BackgroundBrush}">

        <TabControl
            SelectedIndex="{Binding SelectedTabIndex}"
            TabStripPlacement="Top"
            Margin="20 16 20 0">

            <TabControl.ItemContainerTheme>
                <ControlTheme TargetType="TabItem" />
            </TabControl.ItemContainerTheme>

            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>

            <TabItem Header="Projets">
                <ContentControl Content="{Binding ProjectsSection.CurrentPage}" />
            </TabItem>

            <TabItem Header="Stocks">
                <ContentControl Content="{Binding StocksSection.CurrentPage}" />
            </TabItem>

            <TabItem Header="Patrons">
                <ContentControl Content="{Binding PatternsSection.CurrentPage}" />
            </TabItem>

            <TabItem Header="Mes documents">
                <ContentControl Content="{Binding DocumentsSection.CurrentPage}" />
            </TabItem>

            <TabItem Header="Paramètres">
                <ContentControl Content="{Binding SettingsSection.CurrentPage}" />
            </TabItem>

        </TabControl>

        <Border IsVisible="{Binding IsUpdatePromptVisible}"
                Background="#80000000"
                ZIndex="80">
            <Border Classes="surface-card"
                    Width="560"
                    MaxHeight="640"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Classes="notification-dismiss"
                                Command="{Binding CloseUpdatePromptCommand}"
                                IsEnabled="{Binding CanCloseUpdatePrompt}">
                            <LucideIcon Kind="X" Size="14" />
                        </Button>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Mise à jour disponible"
                                       Classes="page-title" />
                            <TextBlock Text="{Binding UpdateVersion, StringFormat='Version {0}'}"
                                       Classes="page-subtitle" />
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="390">
                        <controls:MarkdownTextBlock Markdown="{Binding UpdateReleaseNotes}" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Spacing="12">
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding DownloadProgress}"
                                     IsVisible="{Binding HasDownloadProgress}" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <Button Grid.Column="1"
                                    Classes="cancel-btn"
                                    Command="{Binding CloseUpdatePromptCommand}"
                                    IsEnabled="{Binding CanCloseUpdatePrompt}">
                                <TextBlock Text="Plus tard" />
                            </Button>
                            <Button Grid.Column="2"
                                    Classes="form-submit"
                                    Command="{Binding ConfirmUpdateCommand}"
                                    IsEnabled="{Binding CanConfirmUpdate}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <LucideIcon Kind="Download"
                                                Size="16"
                                                Foreground="{DynamicResource SubmitButtonIconForegroundBrush}" />
                                    <TextBlock Text="Mettre à jour" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <Border IsVisible="{Binding IsReleaseNotesVisible}"
                Background="#80000000"
                ZIndex="80">
            <Border Classes="surface-card"
                    Width="620"
                    MaxHeight="680"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Notes de version"
                                   Classes="page-title" />
                        <TextBlock Text="{Binding CurrentVersion, StringFormat='Version {0}'}"
                                   Classes="page-subtitle" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="460">
                        <controls:MarkdownTextBlock Markdown="{Binding CurrentReleaseNotes}" />
                    </ScrollViewer>

                    <Button Grid.Row="2"
                            Classes="form-submit"
                            HorizontalAlignment="Right"
                            Command="{Binding CloseReleaseNotesCommand}">
                        <TextBlock Text="Fermer" />
                    </Button>
                </Grid>
            </Border>
        </Border>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0 18 18 0"
                ZIndex="50"
                Background="Transparent">
            <ItemsControl Classes="notification-stack"
                          ItemsSource="{Binding Notifications.Notifications}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="notifications:NotificationItemViewModel">
                        <Border Classes="notification-toast"
                                Background="{Binding BackgroundBrush}"
                                BorderBrush="{Binding BorderBrush}"
                                ClipToBounds="True">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Width="34"
                                        Height="34"
                                        CornerRadius="17"
                                        VerticalAlignment="Top"
                                        Background="{Binding AccentBrush}">
                                    <LucideIcon Kind="{Binding IconKind}"
                                                Size="18"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource NotificationIconForegroundBrush}" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Classes="notification-title"
                                               Text="{Binding Title}" />
                                    <TextBlock Classes="notification-message"
                                               Text="{Binding Message}" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Classes="notification-dismiss"
                                        Command="{Binding DismissCommand}"
                                        VerticalAlignment="Top">
                                    <LucideIcon Kind="X"
                                                Size="14"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

    </Grid>
</Window>
