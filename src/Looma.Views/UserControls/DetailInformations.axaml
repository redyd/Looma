<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Looma.Presentation.UserControls;assembly=Looma.Presentation"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Looma.Views.UserControls.DetailInformations"
             x:Name="This">
    
    <Grid ColumnDefinitions="*,16,Auto">

        <Border Grid.Column="0" Classes="form-section" ClipToBounds="True">
            <ItemsControl ItemsSource="{Binding Stats, ElementName=This}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="controls:StatItem">
                        <Border BorderThickness="{Binding IsFirst, Converter={StaticResource FirstItemBorderConverter}}"
                                BorderBrush="{StaticResource BorderBrush}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="4">
                                <TextBlock Text="{Binding Label}" FontSize="12" Opacity="0.5"
                                           HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="4"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Value}"
                                               FontSize="32" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Unit}" FontSize="18" Opacity="0.45"
                                               VerticalAlignment="Bottom" Margin="0 0 0 5" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Grid.Column="2" Classes="form-section" MinWidth="280">
            <StackPanel Spacing="0">
                <TextBlock Classes="section-title"
                           Text="{Binding InfoTitle, ElementName=This}"
                           Margin="0 0 0 14" />
                <ItemsControl ItemsSource="{Binding Infos, ElementName=This}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="controls:InfoItem">
                            <Grid ColumnDefinitions="100,*">
                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                           FontSize="13" Opacity="0.5" Margin="0 0 0 10"
                                           VerticalAlignment="Center" />

                                <!-- Valeur simple -->
                                <TextBlock Grid.Column="1"
                                           IsVisible="{Binding ColorHex, Converter={x:Static ObjectConverters.IsNull}}"
                                           Text="{Binding Value}"
                                           FontSize="14" Margin="0 0 0 10"
                                           VerticalAlignment="Center" />

                                <!-- Valeur couleur -->
                                <StackPanel Grid.Column="1"
                                            IsVisible="{Binding ColorHex, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            Orientation="Horizontal" Spacing="8" Margin="0 0 0 10">
                                    <Ellipse Width="14" Height="14" VerticalAlignment="Center"
                                             Fill="{Binding ColorHex, Converter={StaticResource HexToColor}}" />
                                    <TextBlock Text="{Binding Value}" FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </Grid>
    
</UserControl>