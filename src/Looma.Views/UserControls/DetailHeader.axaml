<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Looma.Views.Markup"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Looma.Views.UserControls.DetailHeader"
             x:Name="This">

    <Border Padding="24 16"
            BorderBrush="{DynamicResource DetailHeaderBorderBrush}"
            BorderThickness="0 0 0 1"
            Background="{DynamicResource DetailHeaderBackgroundBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto">

            <Button Grid.Column="0"
                    Command="{Binding GoBackCommand, ElementName=This}"
                    Classes="cancel-btn">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <LucideIcon Kind="ChevronLeft"
                                Size="16"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Loc Common_Back}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <ContentPresenter Grid.Column="1"
                              Content="{Binding TitleContent, ElementName=This}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="{loc:Loc Common_Edit}"
                        Command="{Binding EditCommand, ElementName=This}"
                        Classes="cancel-btn" />

                <Panel>
                    <Button x:Name="DeleteButton"
                            Content="{loc:Loc Common_Delete}"
                            Click="OnDeleteClicked"
                            Classes="danger-btn" />

                    <Popup x:Name="DeletePopup"
                           PlacementTarget="{Binding #DeleteButton}"
                           Placement="BottomEdgeAlignedLeft"
                           HorizontalOffset="-220">
                        <Border Classes="form-container" Padding="16" Width="280">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:Loc Common_DeleteQuestion}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource FormLabelForegroundBrush}" />
                                <TextBlock Text="{loc:Loc Common_PermanentAction}" Classes="form-hint" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <Button Content="{loc:Loc Common_Cancel}"
                                            Click="OnCancelClicked"
                                            Classes="cancel-btn" />
                                    <Button Content="{loc:Loc Common_Delete}"
                                            Click="OnConfirmClicked"
                                            Classes="danger-btn" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Panel>
            </StackPanel>

        </Grid>
    </Border>
    
</UserControl>
