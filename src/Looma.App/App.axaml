<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Looma.App"
             xmlns:converters="clr-namespace:Looma.Views.Converters;assembly=Looma.Views"
             x:Class="Looma.App.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Looma.Views/Styles/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:HexToColorConverter x:Key="HexToColor" />
            <converters:FirstItemBorderConverter x:Key="FirstItemBorder" />
            <converters:EnumDisplayNameConverter x:Key="EnumDisplayName" />
            <converters:EnumToBoolConverter x:Key="EnumToBool" />
            <converters:StringToUriConverter x:Key="StringToUri" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <StyleInclude Source="avares://Looma.Views/Styles/Layout.axaml" />
        <StyleInclude Source="avares://Looma.Views/Styles/Buttons.axaml" />
        <StyleInclude Source="avares://Looma.Views/Styles/Typography.axaml" />
        <StyleInclude Source="avares://Looma.Views/Styles/Forms.axaml" />
        <StyleInclude Source="avares://Looma.Views/Styles/SurfaceStyles.axaml" />
        <StyleInclude Source="avares://Looma.Views/Styles/NotificationStyles.axaml" />
        <StyleInclude Source="avares://Looma.Views/Styles/Navigation.axaml" />
        <StyleInclude Source="avares://Looma.Views/Styles/EntityCards.axaml" />
        <StyleInclude Source="avares://Looma.Views/Styles/SelectionLists.axaml" />
    </Application.Styles>

    <Application.DataTemplates>
        <app:ViewLocator />
    </Application.DataTemplates>
</Application>
